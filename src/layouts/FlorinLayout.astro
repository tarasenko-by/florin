---
// Standalone Florin layout: page chrome + live re-theming toolbar.
// All styling comes from the published veritheme package (CSS-only design
// system); themes switch via the data-theme attribute, dark via .dark.
import 'veritheme/css';
import '../styles/florin.css';
import { Moon, Sun, Palette } from '@lucide/astro';
import themeManifest from 'veritheme/theme-manifest';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Manrope:wght@400;500;600;700;800&family=Source+Serif+4:wght@400;600;700&display=swap" rel="stylesheet">
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Florin" />
  <meta name="author" content="Siarhei Tarasenka" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script is:inline>
    // Runs before paint: set the theme preset + dark mode with no flash.
    // Dark follows an explicit stored choice, otherwise the OS preference.
    (function () {
      var root = document.documentElement;
      try {
        var theme = localStorage.getItem('florin-theme');
        if (theme) root.setAttribute('data-theme', theme);
      } catch (e) {}
      if (!root.hasAttribute('data-theme')) root.setAttribute('data-theme', 'default');
      try {
        var stored = localStorage.getItem('florin-mode'); // 'dark' | 'light' | null
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) root.classList.add('dark');
      } catch (e) {}
    })();
  </script>
</head>
<body class="vt-bg-surfaces-background vt-text-mains-primary vt-min-h-screen">
  <slot />

  <!-- Theming toolbar: pick a Veritheme preset + toggle dark mode. -->
  <div data-theme-toolbar class="vt-toolbar vt-fixed vt-bottom-4 vt-right-4 vt-z-50 vt-shadow-lg">
    <div id="theme-panel" class="vt-hidden vt-items-center vt-gap-1">
      <select id="theme-select" class="vt-select-trigger vt-h-10 vt-w-40" aria-label="Theme preset">
        {themeManifest.map((t) => (
          <option value={t.name}>{t.label}</option>
        ))}
      </select>
      <button id="mode-toggle" type="button" class="vt-toolbar-btn" title="Toggle dark mode" aria-pressed="false">
        <span id="mode-moon" class="vt-flex"><Moon class="vt-w-4 vt-h-4 vt-text-mains-secondary" /></span>
        <span id="mode-sun" class="vt-hidden"><Sun class="vt-w-4 vt-h-4 vt-text-mains-secondary" /></span>
      </button>
    </div>
    <button id="theme-fab" type="button" class="vt-toolbar-btn" title="Theme options" aria-expanded="false" aria-controls="theme-panel">
      <Palette class="vt-w-4 vt-h-4 vt-text-mains-secondary" />
    </button>
  </div>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      var fab = document.getElementById('theme-fab');
      var panel = document.getElementById('theme-panel');
      var themeSelect = document.getElementById('theme-select');
      var modeBtn = document.getElementById('mode-toggle');
      var moon = document.getElementById('mode-moon');
      var sun = document.getElementById('mode-sun');

      fab.addEventListener('click', function () {
        var open = panel.classList.toggle('vt-flex');
        panel.classList.toggle('vt-hidden', !open);
        fab.setAttribute('aria-expanded', open ? 'true' : 'false');
      });

      themeSelect.value = root.getAttribute('data-theme') || 'default';
      themeSelect.addEventListener('change', function () {
        root.setAttribute('data-theme', themeSelect.value);
        try { localStorage.setItem('florin-theme', themeSelect.value); } catch (e) {}
      });

      // Reflect the current dark state (set pre-paint from OS/stored) in the toggle.
      function syncMode() {
        var dark = root.classList.contains('dark');
        modeBtn.setAttribute('aria-pressed', dark ? 'true' : 'false');
        moon.classList.toggle('vt-hidden', dark);
        moon.classList.toggle('vt-flex', !dark);
        sun.classList.toggle('vt-hidden', !dark);
        sun.classList.toggle('vt-flex', dark);
      }
      syncMode();

      modeBtn.addEventListener('click', function () {
        var dark = root.classList.toggle('dark');
        try { localStorage.setItem('florin-mode', dark ? 'dark' : 'light'); } catch (e) {}
        syncMode();
      });

      // Follow the OS theme live — until the visitor picks a mode explicitly.
      var mq = window.matchMedia('(prefers-color-scheme: dark)');
      var onOsChange = function (e) {
        var stored = null;
        try { stored = localStorage.getItem('florin-mode'); } catch (err) {}
        if (stored) return; // explicit choice wins
        root.classList.toggle('dark', e.matches);
        syncMode();
      };
      if (mq.addEventListener) mq.addEventListener('change', onOsChange);
      else if (mq.addListener) mq.addListener(onOsChange);
    })();
  </script>
</body>
</html>
