---
// Shared Florin app shell: sidebar + top bar, wrapped in FlorinLayout (which
// provides the page chrome + live re-theming toolbar). Each screen supplies its
// own <main> content via the default slot and marks the active nav item.
import FlorinLayout from '../layouts/FlorinLayout.astro';
import '../styles/florin.css';
import { FACES } from '../data/images';
import {
  LayoutDashboard, Receipt, Wallet, CreditCard, ChartColumn, ArrowLeftRight,
  Send, PiggyBank, Settings, CircleQuestionMark as HelpCircle, Bell, Search,
  ChevronDown, LogOut, CircleCheck, TriangleAlert, ArrowDownLeft, Menu,
  Layers, LogIn, UserPlus, KeyRound,
} from '@lucide/astro';

interface Props {
  title: string;
  description: string;
  active: string;
}
const { title, description, active } = Astro.props;

const notifications = [
  { icon: ArrowDownLeft,  tone: 'vt-text-success-primary', title: 'Payment received', desc: 'Stripe Payout · +$12,480.00', time: '2m' },
  { icon: TriangleAlert,  tone: 'vt-text-error-primary',   title: 'Transfer failed',   desc: 'WeWork · $2,600.00',        time: '1h' },
  { icon: CircleCheck,    tone: 'vt-text-info-primary',    title: 'Invoice paid',      desc: 'Client · Aster · $5,400.00', time: '3h' },
];

const banking = [
  { key: 'overview',     label: 'Overview',     href: '/overview',     icon: LayoutDashboard },
  { key: 'transactions', label: 'Transactions', href: '/transactions', icon: Receipt, badge: '12' },
  { key: 'accounts',     label: 'Accounts',     href: '/accounts',     icon: Wallet },
  { key: 'cards',        label: 'Cards',        href: '/cards',        icon: CreditCard },
  { key: 'analytics',    label: 'Analytics',    href: '/analytics',    icon: ChartColumn },
];
const money = [
  { key: 'transfer', label: 'Transfer', href: '/transfer', icon: ArrowLeftRight },
  { key: 'payments', label: 'Payments', href: '/payments', icon: Send },
  { key: 'savings',  label: 'Savings',  href: '/savings',  icon: PiggyBank },
];
// Collapsible nested group — demonstrates the sidebar supports sub-lists.
const pages = [
  { key: 'login',    label: 'Login',          href: '/login',           icon: LogIn },
  { key: 'signup',   label: 'Sign up',        href: '/signup',          icon: UserPlus },
  { key: 'forgot',   label: 'Reset password', href: '/forgot-password', icon: KeyRound },
  { key: 'notfound', label: '404 page',       href: '/404',             icon: TriangleAlert },
];
---

<FlorinLayout title={title} description={description}>
  <div class="vt-flex vt-h-screen vt-overflow-hidden">

    <!-- Mobile drawer backdrop -->
    <div data-sidebar-backdrop class="vt-hidden vt-fixed vt-inset-0 vt-z-30 vt-bg-generic-black/50 vt-lg:hidden"></div>

    <!-- Sidebar (static on desktop; off-canvas drawer under lg — see <style> below) -->
    <aside data-sidebar class="vt-flex vt-flex-col vt-w-64 vt-flex-shrink-0 vt-border-r vt-border-border-default vt-bg-surfaces-surface">
      <div class="vt-h-14 vt-flex vt-items-center vt-px-5 vt-border-b vt-border-border-default">
        <a href="/overview" class="vt-flex vt-items-center vt-gap-2" aria-label="Florin — go to overview">
          <div class="vt-icon-badge vt-icon-badge-sm vt-icon-badge-square vt-bg-accents-brand">
            <span class="vt-text-xs vt-font-bold vt-text-generic-white">F</span>
          </div>
          <span class="vt-text-sm vt-font-bold">Florin</span>
        </a>
      </div>

      <nav class="vt-flex-1 vt-p-3 vt-overflow-y-auto" aria-label="Sidebar navigation">
        <p class="vt-section-label vt-px-3 vt-py-2">Banking</p>
        <div class="vt-space-y-0.5">
          {banking.map((item) => (
            <a href={item.href} class={`vt-nav-item${active === item.key ? ' vt-active' : ''}`} aria-current={active === item.key ? 'page' : undefined}>
              <item.icon class="vt-w-4 vt-h-4" /> {item.label}
              {item.badge && <span class="vt-count-badge vt-ml-auto">{item.badge}</span>}
            </a>
          ))}
        </div>

        <p class="vt-section-label vt-px-3 vt-py-2 vt-mt-4">Money</p>
        <div class="vt-space-y-0.5">
          {money.map((item) => (
            <a href={item.href} class={`vt-nav-item${active === item.key ? ' vt-active' : ''}`} aria-current={active === item.key ? 'page' : undefined}>
              <item.icon class="vt-w-4 vt-h-4" /> {item.label}
            </a>
          ))}
        </div>

        <!-- Collapsible nested group: a parent nav item that expands a sub-list -->
        <p class="vt-section-label vt-px-3 vt-py-2 vt-mt-4">Pages</p>
        <div class="vt-space-y-0.5">
          <button type="button" class="vt-nav-item vt-w-full" data-nav-group="pages" aria-expanded="true">
            <Layers class="vt-w-4 vt-h-4" /> Auth &amp; errors
            <ChevronDown class="vt-w-4 vt-h-4 vt-ml-auto vt-transition-transform" data-nav-caret />
          </button>
          <div data-nav-children="pages" class="vt-space-y-0.5 vt-mt-0.5 vt-ml-4 vt-pl-2 vt-border-l vt-border-border-default">
            {pages.map((item) => (
              <a href={item.href} class={`vt-nav-item${active === item.key ? ' vt-active' : ''}`}>
                <item.icon class="vt-w-4 vt-h-4" /> {item.label}
              </a>
            ))}
          </div>
        </div>
      </nav>

      <div class="vt-p-3 vt-border-t vt-border-border-default">
        <a href="/help" class={`vt-nav-item${active === 'help' ? ' vt-active' : ' vt-muted'}`}><HelpCircle class="vt-w-4 vt-h-4" /> Help center</a>
        <!-- Single account entry point: identity + Profile/Settings/Billing/Log out -->
        <div class="vt-relative">
          <button class="vt-flex vt-items-center vt-gap-3 vt-w-full vt-text-left vt-px-3 vt-py-3 vt-rounded-xl vt-transition-colors vt-hover:bg-surfaces-subtle" data-dropdown-trigger="acct-menu" aria-label="Account menu">
            <div class="vt-avatar vt-avatar-sm"><img src={FACES.SL} alt="Sofia Marchetti" /></div>
            <div class="vt-min-w-0 vt-flex-1">
              <p class="vt-text-sm vt-font-medium vt-truncate">Sofia Marchetti</p>
              <p class="vt-text-xs vt-text-mains-quaternary vt-truncate">Owner · Nord Studio</p>
            </div>
            <ChevronDown class="vt-w-4 vt-h-4 vt-text-mains-quaternary vt-flex-shrink-0" />
          </button>
          <div id="acct-menu" data-menu class="vt-hidden vt-absolute vt-left-0 vt-right-0 vt-bottom-full vt-mb-2 vt-p-1 vt-rounded-xl vt-border vt-border-border-default vt-bg-surfaces-surface vt-shadow-lg vt-z-50">
            <div class="vt-px-3 vt-py-2">
              <p class="vt-text-sm vt-font-medium vt-truncate">Sofia Marchetti</p>
              <p class="vt-text-xs vt-text-mains-quaternary vt-truncate">sofia@nordstudio.co</p>
            </div>
            <div class="vt-command-separator vt-mb-1"></div>
            <a href="/settings" class={`vt-command-item${active === 'settings' ? ' vt-active' : ''}`}><Settings class="vt-w-4 vt-h-4" /> Settings</a>
            <a href="/billing" class={`vt-command-item${active === 'billing' ? ' vt-active' : ''}`}><CreditCard class="vt-w-4 vt-h-4" /> Billing</a>
            <div class="vt-command-separator vt-my-1"></div>
            <a href="/login" class="vt-command-item vt-text-error-primary"><LogOut class="vt-w-4 vt-h-4" /> Log out</a>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main column -->
    <div class="vt-flex-1 vt-min-w-0 vt-flex vt-flex-col vt-min-h-0">
      <header class="vt-h-14 vt-flex-shrink-0 vt-border-b vt-border-border-default vt-bg-surfaces-surface vt-flex vt-items-center vt-justify-between vt-gap-4 vt-px-6">
        <div class="vt-flex vt-items-center vt-gap-2 vt-w-full vt-max-w-xs">
          <button class="vt-notification-btn vt-lg:hidden vt-flex-shrink-0" data-sidebar-toggle aria-label="Open menu">
            <Menu class="vt-w-5 vt-h-5 vt-text-mains-secondary" />
          </button>
          <div class="vt-relative vt-flex vt-w-full vt-items-center">
            <Search class="vt-w-4 vt-h-4 vt-absolute vt-left-3 vt-text-mains-quaternary" />
            <input class="vt-input vt-pl-10" type="search" placeholder="Search transactions…" aria-label="Search" />
          </div>
        </div>
        <div class="vt-flex vt-items-center vt-gap-1">
          <div class="vt-relative">
            <button class="vt-btn vt-btn-ghost vt-btn-icon vt-relative" aria-label="Notifications" data-dropdown-trigger="notif-menu">
              <Bell class="vt-w-4 vt-h-4" />
              <span class="vt-absolute vt-top-2 vt-right-2 vt-w-2 vt-h-2 vt-rounded-full vt-bg-error-primary vt-ring-2 vt-ring-surfaces-surface"></span>
            </button>
            <div id="notif-menu" data-menu class="vt-hidden vt-absolute vt-right-0 vt-top-full vt-mt-2 vt-w-80 vt-p-1 vt-rounded-xl vt-border vt-border-border-default vt-bg-surfaces-surface vt-shadow-lg vt-z-50">
              <div class="vt-flex vt-items-center vt-justify-between vt-px-3 vt-py-2">
                <span class="vt-text-sm vt-font-semibold">Notifications</span>
                <span class="vt-badge vt-badge-soft vt-badge-info">3 new</span>
              </div>
              <div class="vt-command-separator vt-mb-1"></div>
              {notifications.map((n) => (
                <a href="#" class="vt-command-item">
                  <div class={`vt-icon-badge vt-icon-badge-sm ${n.tone}`}><n.icon class="vt-w-4 vt-h-4" /></div>
                  <div class="vt-min-w-0 vt-flex-1">
                    <p class="vt-text-sm vt-font-medium vt-truncate">{n.title}</p>
                    <p class="vt-text-xs vt-text-mains-quaternary vt-truncate">{n.desc}</p>
                  </div>
                  <span class="vt-text-xs vt-text-mains-quaternary vt-flex-shrink-0">{n.time}</span>
                </a>
              ))}
              <div class="vt-command-separator vt-my-1"></div>
              <a href="/notifications" class="vt-command-item vt-justify-center vt-text-sm vt-font-medium">View all notifications</a>
            </div>
          </div>
        </div>
      </header>

      <main class="vt-flex-1 vt-overflow-y-auto vt-p-6 vt-space-y-6">
        <slot />
      </main>
    </div>
  </div>

  <!-- Florin demo interactivity: functional dropdowns, switches, and the
       transactions filter/search — so the template can be actually driven. -->
  <script is:inline>
    (function () {
      // Portal modal overlays to <body> so their fixed overlay always covers the
      // full viewport — nesting inside the scrollable shell offset it from the top.
      document.querySelectorAll('.vt-dialog-overlay').forEach(function (ov) { document.body.appendChild(ov); });

      // `.vt-select-dropdown` shows via `.open` (its base is display:none);
      // pop menus ([data-menu]) toggle via `vt-hidden`.
      function closeMenus(except) {
        document.querySelectorAll('.vt-select-dropdown').forEach(function (m) {
          if (m !== except) m.classList.remove('open');
        });
        document.querySelectorAll('[data-menu]').forEach(function (m) {
          if (m !== except) m.classList.add('vt-hidden');
        });
      }
      document.addEventListener('click', function () { closeMenus(null); });

      // Functional selects: trigger toggles the dropdown; item click sets the label.
      document.querySelectorAll('.vt-select-wrapper').forEach(function (wrap) {
        var trigger = wrap.querySelector('.vt-select-trigger');
        var dropdown = wrap.querySelector('.vt-select-dropdown');
        var label = wrap.querySelector('[data-select-label]');
        if (!trigger || !dropdown) return;
        trigger.addEventListener('click', function (e) {
          e.stopPropagation();
          var willOpen = !dropdown.classList.contains('open');
          closeMenus(null);
          dropdown.classList.toggle('open', willOpen);
        });
        dropdown.querySelectorAll('.vt-select-item').forEach(function (item) {
          item.addEventListener('click', function () {
            if (label) label.textContent = item.textContent.trim();
            dropdown.querySelectorAll('.vt-select-item').forEach(function (i) { i.removeAttribute('aria-selected'); });
            item.setAttribute('aria-selected', 'true');
            dropdown.classList.remove('open');
          });
        });
      });

      // Action menus (topbar/user, row actions).
      document.querySelectorAll('[data-dropdown-trigger]').forEach(function (btn) {
        var menu = document.getElementById(btn.getAttribute('data-dropdown-trigger'));
        if (!menu) return;
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var open = menu.classList.contains('vt-hidden');
          closeMenus(open ? menu : null);
          menu.classList.toggle('vt-hidden', !open);
        });
        // Keep the menu open while interacting inside it (e.g. filter checkboxes);
        // links still navigate. Outside clicks still close it.
        menu.addEventListener('click', function (e) { e.stopPropagation(); });
      });

      // Collapsible sidebar groups: parent button expands/collapses its sub-list.
      document.querySelectorAll('[data-nav-group]').forEach(function (btn) {
        var name = btn.getAttribute('data-nav-group');
        var children = document.querySelector('[data-nav-children="' + name + '"]');
        var caret = btn.querySelector('[data-nav-caret]');
        if (!children) return;
        btn.addEventListener('click', function () {
          children.classList.toggle('vt-hidden');
          var expanded = !children.classList.contains('vt-hidden');
          btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
          if (caret) caret.style.transform = expanded ? '' : 'rotate(-90deg)';
        });
      });

      // Switches: toggle on click.
      document.querySelectorAll('[role="switch"]').forEach(function (sw) {
        sw.addEventListener('click', function () {
          var on = sw.getAttribute('aria-checked') !== 'true';
          sw.setAttribute('aria-checked', on ? 'true' : 'false');
          sw.classList.toggle('vt-active', on);
          sw.classList.toggle('vt-bg-accents-brand', on);
          sw.classList.toggle('vt-bg-surfaces-moderate', !on);
        });
      });

      // "Clear" resets its form card (text fields empty, selects back to first item).
      document.querySelectorAll('[data-form-clear]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var card = btn.closest('.vt-card');
          if (!card) return;
          card.querySelectorAll('input, textarea').forEach(function (f) { f.value = ''; });
          card.querySelectorAll('.vt-select-wrapper').forEach(function (w) {
            var first = w.querySelector('.vt-select-item');
            var label = w.querySelector('[data-select-label]');
            if (first && label) label.textContent = first.textContent.trim();
          });
        });
      });

      // Transactions: filter tabs + live search.
      var filterBtns = document.querySelectorAll('[data-tx-filter]');
      var search = document.querySelector('[data-tx-search]');
      var rows = document.querySelectorAll('[data-tx-row]');
      var empty = document.querySelector('[data-tx-empty]');
      var statusInputs = document.querySelectorAll('[data-tx-status-filter]');
      var current = 'all';
      function apply() {
        var q = (search && search.value || '').toLowerCase().trim();
        var statuses = [];
        statusInputs.forEach(function (i) { if (i.checked) statuses.push(i.value); });
        var shown = 0;
        rows.forEach(function (row) {
          var type = row.getAttribute('data-tx-type');
          var name = (row.getAttribute('data-tx-name') || '').toLowerCase();
          var status = row.getAttribute('data-tx-status');
          var ok = (current === 'all' || type === current)
            && (!q || name.indexOf(q) >= 0)
            && (!statuses.length || statuses.indexOf(status) >= 0);
          row.classList.toggle('vt-hidden', !ok);
          if (ok) shown++;
        });
        if (empty) empty.classList.toggle('vt-hidden', shown !== 0);
      }
      filterBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          current = btn.getAttribute('data-tx-filter');
          filterBtns.forEach(function (b) { b.classList.remove('vt-active'); });
          btn.classList.add('vt-active');
          apply();
        });
      });
      if (search) search.addEventListener('input', apply);
      statusInputs.forEach(function (i) { i.addEventListener('change', apply); });
      // Empty-state "Clear filters" → reset search + tabs + status, then re-apply.
      var clearBtn = document.querySelector('[data-tx-clear]');
      if (clearBtn) clearBtn.addEventListener('click', function () {
        if (search) search.value = '';
        statusInputs.forEach(function (i) { i.checked = false; });
        current = 'all';
        filterBtns.forEach(function (b) { b.classList.remove('vt-active'); });
        var allBtn = document.querySelector('[data-tx-filter="all"]');
        if (allBtn) allBtn.classList.add('vt-active');
        apply();
      });

      // Sortable table columns: click a th[data-sort]; rows carry data-sort-<key>.
      document.querySelectorAll('th[data-sort]').forEach(function (th) {
        th.style.cursor = 'pointer';
        th.addEventListener('click', function () {
          var key = th.getAttribute('data-sort');
          var table = th.closest('table');
          var tbody = table.querySelector('tbody');
          var asc = th.getAttribute('data-sort-dir') !== 'asc';
          table.querySelectorAll('th[data-sort]').forEach(function (o) { if (o !== th) o.removeAttribute('data-sort-dir'); });
          th.setAttribute('data-sort-dir', asc ? 'asc' : 'desc');
          var list = [].slice.call(tbody.querySelectorAll('[data-tx-row]'));
          list.sort(function (a, b) {
            var va = a.getAttribute('data-sort-' + key) || '';
            var vb = b.getAttribute('data-sort-' + key) || '';
            var na = parseFloat(va), nb = parseFloat(vb);
            var cmp = (!isNaN(na) && !isNaN(nb)) ? na - nb : va.localeCompare(vb);
            return asc ? cmp : -cmp;
          });
          var anchor = tbody.querySelector('[data-tx-empty]');
          list.forEach(function (r) { tbody.insertBefore(r, anchor); });
        });
      });

      // Modals: open via [data-modal-open="id"]; close via [data-modal-close],
      // an overlay backdrop click, or Esc.
      function closeModal(ov) { if (ov) ov.classList.remove('vt-open'); }
      document.querySelectorAll('[data-modal-open]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          var m = document.getElementById(btn.getAttribute('data-modal-open'));
          if (m) m.classList.add('vt-open');
        });
      });
      document.querySelectorAll('[data-modal-close]').forEach(function (btn) {
        btn.addEventListener('click', function () { closeModal(btn.closest('.vt-dialog-overlay')); });
      });
      document.querySelectorAll('.vt-dialog-overlay').forEach(function (ov) {
        ov.addEventListener('click', function (e) { if (e.target === ov) closeModal(ov); });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') document.querySelectorAll('.vt-dialog-overlay.vt-open').forEach(closeModal);
      });

      // "Save changes" stays disabled until its form is edited.
      document.querySelectorAll('[data-dirty-form]').forEach(function (form) {
        var save = form.querySelector('[data-dirty-save]');
        if (!save) return;
        save.disabled = true;
        function dirty() { save.disabled = false; }
        form.querySelectorAll('input, textarea').forEach(function (f) { f.addEventListener('input', dirty); });
        form.querySelectorAll('.vt-select-item').forEach(function (i) { i.addEventListener('click', dirty); });
        save.addEventListener('click', function () { save.disabled = true; }); // "saved"
      });

      // Hover tooltip for chart bars (any element with [data-tip]).
      var tip = document.createElement('div');
      tip.style.cssText = 'position:fixed;z-index:60;padding:4px 8px;border-radius:6px;background:hsl(var(--mains-primary));color:hsl(var(--surfaces-surface));font-size:12px;font-weight:500;line-height:1.3;pointer-events:none;box-shadow:0 4px 12px hsl(var(--generic-1000)/0.18);display:none;white-space:nowrap;';
      document.body.appendChild(tip);
      document.addEventListener('mouseover', function (e) {
        var el = e.target.closest && e.target.closest('[data-tip]');
        if (!el) return;
        tip.textContent = el.getAttribute('data-tip');
        tip.style.display = 'block';
      });
      document.addEventListener('mousemove', function (e) {
        if (tip.style.display === 'none') return;
        tip.style.left = (e.clientX + 12) + 'px';
        tip.style.top = (e.clientY - 10) + 'px';
      });
      document.addEventListener('mouseout', function (e) {
        if (e.target.closest && e.target.closest('[data-tip]')) tip.style.display = 'none';
      });

      // Mobile sidebar drawer.
      var sidebar = document.querySelector('[data-sidebar]');
      var sbBackdrop = document.querySelector('[data-sidebar-backdrop]');
      function setSidebar(open) {
        if (!sidebar) return;
        sidebar.classList.toggle('is-open', open);
        if (sbBackdrop) sbBackdrop.classList.toggle('vt-hidden', !open);
      }
      var sbToggle = document.querySelector('[data-sidebar-toggle]');
      if (sbToggle) sbToggle.addEventListener('click', function () { setSidebar(!sidebar.classList.contains('is-open')); });
      if (sbBackdrop) sbBackdrop.addEventListener('click', function () { setSidebar(false); });
      if (sidebar) sidebar.querySelectorAll('a[href^="/florin"]').forEach(function (a) {
        a.addEventListener('click', function () { setSidebar(false); });
      });
    })();
  </script>
</FlorinLayout>
