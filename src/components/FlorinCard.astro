---
// Florin's payment card — ONE markup for every place a card appears:
//   overview  (balance=…: the account balance in place of the chip/number)
//   accounts  (static card)
//   cards     (interactive: the wallet script swaps the feat-* nodes and
//              toggles .fl-card-graphite)
//   cards     (mini: the swatch in the card picker — skin only, no content)
// The brand card re-skins with the theme (brand fill + on-brand text); the
// virtual one is graphite. Every colour is a token; the look lives in <style>.
interface Props {
  name?: string;
  kind?: string;
  last?: string;
  exp?: string;
  holder?: string;
  brand?: boolean;
  net?: string;
  /** Show this balance (and its label) instead of the chip + full number. */
  balance?: string;
  balanceLabel?: string;
  /** Skin only, as a small inline swatch (for the card picker). */
  mini?: boolean;
  /** Emit the feat-* ids the cards-page wallet script updates. */
  interactive?: boolean;
  id?: string;
  class?: string;
}
const {
  name = '', kind = '', last = '', exp = '', holder = '', brand = true, net = 'VISA',
  balance, balanceLabel = '', mini = false, interactive = false, id, class: cls = '', ...rest
} = Astro.props;
const fid = (k: string) => (interactive ? `feat-${k}` : undefined);
---

{mini ? (
  <span class:list={['fl-card', 'fl-card-mini', { 'fl-card-graphite': !brand }, cls]} aria-hidden="true" {...rest}></span>
) : (
  <div id={id} class:list={['fl-card', { 'fl-card-graphite': !brand }, cls]} {...rest}>
    <div class="vt-flex vt-items-start vt-justify-between vt-gap-3">
      <div class="vt-min-w-0">
        <p class="vt-caption fl-card-dim">Florin</p>
        <p class="vt-label-md vt-truncate"><span id={fid('name')}>{name}</span> · <span id={fid('kind')}>{kind}</span></p>
      </div>
      <span id={fid('net')} class="vt-label-md fl-card-net">{net}</span>
    </div>
    {balance ? (
      <div>
        <p class="vt-caption fl-card-dim">{balanceLabel}</p>
        <p class="vt-heading-md">{balance}</p>
      </div>
    ) : (
      <div class="fl-card-chip" aria-hidden="true"></div>
    )}
    <div>
      {balance ? (
        <div class="vt-flex vt-items-center vt-justify-between vt-gap-3">
          <span class="vt-label-md vt-tracking-wider">•••• {last}</span>
          <span class="vt-caption fl-card-dim">{exp}</span>
        </div>
      ) : (
        <>
          <p id={fid('num')} class="vt-label-lg vt-tracking-wider">•••• •••• •••• {last}</p>
          <div class="vt-flex vt-items-center vt-justify-between vt-gap-3 vt-mt-2">
            <span id={fid('holder')} class="vt-caption fl-card-dim">{holder}</span>
            <span id={fid('exp')} class="vt-caption fl-card-dim">{exp}</span>
          </div>
        </>
      )}
    </div>
  </div>
)}

<style>
  /* Card skin: a real card's 1.586 ratio and a brand gradient — no library component for a payment card. */
  .fl-card {
    --fl-card-a: hsl(var(--vt-brand-fill));
    --fl-card-b: hsl(var(--vt-brand-fill) / 0.72);
    --fl-card-fg: var(--vt-on-brand);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    aspect-ratio: 1.586;
    padding: var(--vt-spacing-5);
    border-radius: var(--vt-radius-2xl);
    background: linear-gradient(135deg, var(--fl-card-a), var(--fl-card-b));
    color: hsl(var(--fl-card-fg));
  }
  /* Virtual card: graphite from the grey scale with white text, the same in both modes. */
  .fl-card-graphite {
    --fl-card-a: hsl(var(--vt-grey-700));
    --fl-card-b: hsl(var(--vt-grey-900));
    --fl-card-fg: var(--vt-generic-0);
    /* A hairline edge, so the dark card does not melt into a dark-mode surface. */
    box-shadow: inset 0 0 0 var(--vt-border-width-default) hsl(var(--fl-card-fg) / 0.12);
  }
  /* Decorative circle in the top corner: the on-colour at low alpha, so it follows any theme. */
  .fl-card::before {
    content: '';
    position: absolute;
    top: -48px;
    right: -48px;
    width: 170px;
    height: 170px;
    border-radius: var(--vt-radius-full);
    background: hsl(var(--fl-card-fg) / 0.08);
    pointer-events: none;
  }
  /* Keep the content above the circle. */
  .fl-card > * { position: relative; }
  /* Secondary text on the card: the on-colour, dimmed (muted tokens are meant for the page surface). */
  .fl-card-dim { opacity: 0.85; }
  /* Network mark (VISA / MC) reads as a logotype, not a label. */
  .fl-card-net { font-weight: 700; font-style: italic; }
  /* EMV chip: a gold gradient from the yellow palette. */
  .fl-card-chip {
    width: 38px;
    height: 28px;
    border-radius: var(--vt-radius-md);
    background: linear-gradient(135deg, hsl(var(--vt-yellow-200)), hsl(var(--vt-yellow-600)));
  }
  /* Picker swatch: the same skin at 48×32, without content or circle. */
  .fl-card-mini {
    display: block;
    flex-shrink: 0;
    width: var(--vt-spacing-12);
    height: var(--vt-spacing-8);
    aspect-ratio: auto;
    padding: 0;
    border-radius: var(--vt-radius-md);
  }
  .fl-card-mini::before { content: none; }
</style>
