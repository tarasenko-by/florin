---
import { url } from '../lib/url';
// Shared shell-less layout for Florin auth screens, built on Veritheme's Auth
// split (vt-auth-split): the form on the left, a brand-coloured panel on the
// right that RE-SKINS with the active theme (the campaign's whole hook).
// Pages pass the heading via props and the form (social sign-in, fields,
// footer link) via the default slot.
import FlorinLayout from '../layouts/FlorinLayout.astro';
import { Check } from '@lucide/astro';

interface Props {
  /** Document <title> */
  title: string;
  /** Meta description */
  description: string;
  /** Visible page heading (vt-auth-title) */
  heading: string;
  /** Line under the heading (vt-auth-description) */
  lede: string;
}
const { title, description, heading, lede } = Astro.props;

const perks = [
  'Multi-currency accounts in minutes',
  'Issue virtual cards instantly',
  'Real-time spend analytics',
];
---

<FlorinLayout title={title} description={description}>
  <div class="vt-min-h-screen vt-flex vt-p-4">
    <div class="vt-auth-split vt-flex-1">
      <!-- Form panel -->
      <main class="vt-auth-split-main">
        <div class="vt-auth">
          <div class="vt-auth-header">
            <a href={url('/overview')} class="vt-flex vt-items-center vt-gap-2" aria-label="Florin — go to overview">
              <span class="vt-icon-badge vt-icon-badge-square fl-logo-mark vt-label-md" aria-hidden="true">F</span>
              <span class="vt-label-lg">Florin</span>
            </a>
            <div class="vt-auth-heading">
              <h1 class="vt-auth-title">{heading}</h1>
              <p class="vt-auth-description">{lede}</p>
            </div>
          </div>
          <slot />
        </div>
      </main>

      <!-- Brand panel: Auth's aside (shown from 1024px), painted with the theme's brand -->
      <aside class="vt-auth-aside fl-auth-brand">
        <span class="fl-auth-orb fl-auth-orb-a" aria-hidden="true"></span>
        <span class="fl-auth-orb fl-auth-orb-b" aria-hidden="true"></span>

        <div class="vt-relative vt-flex vt-items-center vt-gap-2">
          <span class="fl-auth-mark vt-label-sm" aria-hidden="true">F</span>
          <span class="vt-label-lg">Florin</span>
        </div>

        <div class="vt-relative">
          <p class="vt-heading-lg vt-max-w-sm">Business banking that moves at your speed.</p>
          <ul class="vt-space-y-3 vt-mt-6">
            {perks.map((p) => (
              <li class="vt-flex vt-items-center vt-gap-3">
                <span class="fl-auth-tick" aria-hidden="true"><Check class="vt-w-3 vt-h-3" stroke-width={3} /></span>
                <span class="vt-body-sm vt-opacity-90">{p}</span>
              </li>
            ))}
          </ul>
          <p class="vt-caption vt-opacity-70 vt-mt-8">Trusted by 12,000+ businesses · Built with Veritheme</p>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    // Static template, no library JS on these screens: the "remember me" /
    // "agree" checkboxes toggle here so they are not dead controls.
    document.querySelectorAll('.vt-check-label [role="checkbox"]').forEach(function (box) {
      function toggle() {
        var on = box.getAttribute('aria-checked') !== 'true';
        box.setAttribute('aria-checked', on ? 'true' : 'false');
        box.classList.toggle('checked', on);
      }
      box.closest('.vt-check-label').addEventListener('click', function (e) {
        if (e.target.closest('a')) return; // the Terms links navigate
        e.preventDefault();
        toggle();
      });
      box.addEventListener('keydown', function (e) {
        if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggle(); }
      });
    });
  </script>
</FlorinLayout>

<style>
  /* Auth's aside is a neutral surface in 1.2.1; Florin's panel is the brand,
     so it follows the active theme. Content sits top and bottom. */
  .fl-auth-brand {
    position: relative;
    overflow: hidden;
    justify-content: space-between;
    color: hsl(var(--vt-on-brand));
    background: linear-gradient(140deg, hsl(var(--vt-brand-fill)), hsl(var(--vt-brand-fill) / 0.62));
  }
  /* Decorative circles in the panel's corners. */
  .fl-auth-orb {
    position: absolute;
    border-radius: var(--vt-radius-full);
    pointer-events: none;
  }
  .fl-auth-orb-a {
    inset-inline-end: -80px;
    top: -80px;
    width: 280px;
    height: 280px;
    background: hsl(var(--vt-on-brand) / 0.1);
  }
  .fl-auth-orb-b {
    inset-inline-start: -70px;
    bottom: -70px;
    width: 220px;
    height: 220px;
    background: hsl(var(--vt-on-brand) / 0.07);
  }
  /* The brand mark and perk ticks: translucent on-brand chips on the panel. */
  .fl-auth-mark,
  .fl-auth-tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: hsl(var(--vt-on-brand) / 0.2);
  }
  .fl-auth-mark {
    width: var(--vt-spacing-7);
    height: var(--vt-spacing-7);
    border-radius: var(--vt-radius-sm);
  }
  .fl-auth-tick {
    width: var(--vt-spacing-6);
    height: var(--vt-spacing-6);
    border-radius: var(--vt-radius-full);
  }
</style>
