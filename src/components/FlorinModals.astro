---
// Shared money modals (Send / Add money / Move). Include on any page whose
// buttons use data-modal-open="send-modal" | "add-money-modal" | "move-modal".
// Wiring (open/close via .vt-open, selects via [data-select]) lives in
// FlorinShell's script. Dialog anatomy: header > heading > title + description,
// body (fields), footer (actions).
import { ChevronDown, Send, Plus, ArrowLeftRight } from '@lucide/astro';

const accounts = [
  'Main · USD — $84,140.00',
  'Savings — $31,500.00',
  'Tax reserve — $12,900.00',
];
const sources = ['Visa •••• 4242', 'Bank transfer (ACH)'];

// One Select per field: label + trigger + options, the contract FlorinShell drives.
const selects = {
  send: [{ id: 'send-from', label: 'From', options: accounts, selected: 0 }],
  add: [
    { id: 'add-to', label: 'To', options: accounts, selected: 0 },
    { id: 'add-from', label: 'From', options: sources, selected: 0 },
  ],
  move: [
    { id: 'move-from', label: 'From', options: accounts, selected: 0 },
    { id: 'move-to', label: 'To', options: accounts, selected: 1 },
  ],
};
type Sel = { id: string; label: string; options: string[]; selected: number };
const dialogs: { id: string; title: string; description: string; selects: Sel[]; amount: string; action: string; icon: typeof Send; recipient?: boolean }[] = [
  { id: 'send-modal', title: 'Send money', description: 'Pay someone or move funds out.', selects: selects.send, amount: 'send-amount', action: 'Send', icon: Send, recipient: true },
  { id: 'add-money-modal', title: 'Add money', description: 'Top up from a linked card or bank.', selects: selects.add, amount: 'add-amount', action: 'Add money', icon: Plus },
  { id: 'move-modal', title: 'Move money', description: 'Transfer instantly between your accounts.', selects: selects.move, amount: 'move-amount', action: 'Move', icon: ArrowLeftRight },
];
---

{dialogs.map((d) => (
  <div id={d.id} class="vt-dialog-overlay" role="dialog" aria-modal="true" aria-labelledby={`${d.id}-title`} aria-describedby={`${d.id}-desc`}>
    <div class="vt-dialog vt-overflow-visible">
      <div class="vt-dialog-header">
        <div class="vt-dialog-heading">
          <h3 id={`${d.id}-title`} class="vt-dialog-title">{d.title}</h3>
          <p id={`${d.id}-desc`} class="vt-dialog-description">{d.description}</p>
        </div>
      </div>
      <div class="vt-dialog-body">
        {d.selects.map((s) => (
          <div class="vt-field">
            <label class="vt-label" for={s.id}>{s.label}</label>
            <div class="vt-relative" data-select>
              <button type="button" id={s.id} class="vt-select-trigger" aria-haspopup="listbox">
                <span data-select-label>{s.options[s.selected]}</span>
                <ChevronDown aria-hidden="true" />
              </button>
              <div class="vt-select-dropdown" role="listbox" aria-label={s.label}>
                {s.options.map((o, i) => (
                  <div class="vt-select-item" role="option" aria-selected={i === s.selected ? 'true' : undefined}>{o}</div>
                ))}
              </div>
            </div>
          </div>
        ))}
        {d.recipient && (
          <div class="vt-field">
            <label class="vt-label" for="send-to">Recipient</label>
            <input id="send-to" class="vt-input" type="text" placeholder="Name, email, or account" />
          </div>
        )}
        <div class="vt-field">
          <label class="vt-label" for={d.amount}>Amount</label>
          <input id={d.amount} class="vt-input" type="text" placeholder="$0.00" inputmode="decimal" />
        </div>
      </div>
      <div class="vt-dialog-footer">
        <button type="button" class="vt-btn vt-btn-ghost" data-modal-close>Cancel</button>
        <button type="button" class="vt-btn vt-btn-primary" data-modal-close><d.icon class="vt-w-4 vt-h-4" /> {d.action}</button>
      </div>
    </div>
  </div>
))}
