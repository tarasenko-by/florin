---
// Florin — Notifications. Full activity feed: a List per day group; each row is
// a button that marks the notification read.
import FlorinShell from '../components/FlorinShell.astro';
import { ArrowDownLeft, TriangleAlert, CircleCheck, Bell, CreditCard, Check } from '@lucide/astro';

// tone: an fl-tone-* tint for the Icon Badge, or '' for the neutral badge.
const groups = [
  {
    label: 'Today',
    items: [
      { icon: ArrowDownLeft, tone: 'fl-tone-success', title: 'Payment received', desc: 'Stripe Payout · +$12,480.00', time: '2m ago', unread: true },
      { icon: TriangleAlert,  tone: 'fl-tone-error',   title: 'Transfer failed',   desc: 'WeWork · $2,600.00 — insufficient funds', time: '1h ago', unread: true },
      { icon: CircleCheck,    tone: 'fl-tone-info',    title: 'Invoice paid',      desc: 'Client · Aster · $5,400.00', time: '3h ago', unread: true },
    ],
  },
  {
    label: 'Earlier',
    items: [
      { icon: CreditCard,  tone: '',             title: 'Card charged', desc: 'AWS · $2,314.90', time: 'Yesterday', unread: false },
      { icon: Bell,        tone: '',             title: 'Weekly summary is ready', desc: 'Net +$8,120 across all accounts', time: 'Mon', unread: false },
      { icon: CircleCheck, tone: 'fl-tone-info', title: 'Payout scheduled', desc: 'Ramp Payroll · $8,420.00 on Jul 28', time: 'Sun', unread: false },
    ],
  },
];
---

<FlorinShell active="notifications" title="Florin — Notifications" description="Florin notifications — full activity feed. Built with Veritheme.">
  <div class="vt-flex vt-items-center vt-justify-between vt-gap-4">
    <div>
      <h1 class="vt-heading-md">Notifications</h1>
      <p class="vt-body-sm vt-text-foreground-muted vt-mt-1"><span data-notif-count>3</span> unread · everything happening in your account.</p>
    </div>
    <button type="button" class="vt-btn vt-btn-bordered" data-notif-markall><Check class="vt-w-4 vt-h-4" /> Mark all read</button>
  </div>

  <div class="vt-max-w-2xl vt-space-y-6">
    {groups.map((g) => (
      <section class="vt-list-section" aria-label={g.label}>
        <h2 class="vt-section-label">{g.label}</h2>
        <div class="vt-list">
          {g.items.map((n) => (
            <button
              type="button"
              data-notif
              class:list={['vt-list-item vt-text-left', { 'vt-bg-brand-tint': n.unread }]}
            >
              <span class:list={['vt-icon-badge vt-icon-badge-sm', n.tone]}><n.icon class="vt-icon-badge-icon" /></span>
              <span class="vt-list-item-content">
                <span class="vt-list-item-title">{n.title}</span>
                <span class="vt-list-item-description">{n.desc}</span>
              </span>
              <span class="vt-list-item-meta vt-flex vt-items-center vt-gap-2 vt-whitespace-nowrap">
                {n.time}
                {n.unread && <span data-notif-dot class="vt-dot vt-dot-brand" role="img" aria-label="Unread"></span>}
              </span>
            </button>
          ))}
        </div>
      </section>
    ))}
  </div>

  <script is:inline>
    (function () {
      var count = document.querySelector('[data-notif-count]');
      function refresh() {
        var n = document.querySelectorAll('[data-notif-dot]').length;
        if (count) count.textContent = n;
      }
      function markRead(row) {
        row.classList.remove('vt-bg-brand-tint');
        var dot = row.querySelector('[data-notif-dot]');
        if (dot) dot.remove();
        refresh();
      }
      document.querySelectorAll('[data-notif]').forEach(function (row) {
        row.addEventListener('click', function () { markRead(row); });
      });
      var all = document.querySelector('[data-notif-markall]');
      if (all) all.addEventListener('click', function () {
        document.querySelectorAll('[data-notif]').forEach(markRead);
      });
    })();
  </script>
</FlorinShell>
