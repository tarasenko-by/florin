---
// Florin — Transactions. Filterable ledger (filter tabs + live search are wired
// in FlorinShell's script via the data-tx-* attributes).
import FlorinShell from '../components/FlorinShell.astro';
import { Download, ListFilter, ArrowDownUp, ArrowUpRight, ArrowDownLeft, Search, SearchX, ChevronLeft, ChevronRight } from '@lucide/astro';

const filters = [
  { label: 'All',       value: 'all' },
  { label: 'Income',    value: 'income' },
  { label: 'Expenses',  value: 'expenses' },
  { label: 'Transfers', value: 'transfers' },
];

// No running-balance column: the ledger mixes accounts, so a single running
// balance would be meaningless. `type` drives the filter tabs; `day`/`amt` are
// the numeric sort keys for the sortable columns.
const rows = [
  { name: 'Stripe Payout',    cat: 'Income',   type: 'income',    acct: 'Main · USD', date: 'Jul 21, 2026', day: 21, method: 'ACH',      amount: '+$12,480.00', amt: 12480,   pos: true,  status: 'Settled', tone: 'vt-badge-success' },
  { name: 'AWS',              cat: 'Software',  type: 'expenses',  acct: 'Main · USD', date: 'Jul 20, 2026', day: 20, method: 'Card',     amount: '−$2,314.90',  amt: -2314.9, pos: false, status: 'Cleared', tone: 'vt-badge-info' },
  { name: 'Figma',            cat: 'Software',  type: 'expenses',  acct: 'Main · USD', date: 'Jul 20, 2026', day: 20, method: 'Card',     amount: '−$144.00',    amt: -144,    pos: false, status: 'Cleared', tone: 'vt-badge-info' },
  { name: 'Contractor · Lee', cat: 'Payroll',   type: 'expenses',  acct: 'Main · USD', date: 'Jul 19, 2026', day: 19, method: 'Wire',     amount: '−$4,200.00',  amt: -4200,   pos: false, status: 'Pending', tone: 'vt-badge-warning' },
  { name: 'Wire · Nord GmbH', cat: 'Income',    type: 'income',    acct: 'Main · USD', date: 'Jul 18, 2026', day: 18, method: 'Wire',     amount: '+$6,900.00',  amt: 6900,    pos: true,  status: 'Settled', tone: 'vt-badge-success' },
  { name: 'WeWork',           cat: 'Office',     type: 'expenses',  acct: 'Main · USD', date: 'Jul 17, 2026', day: 17, method: 'Card',     amount: '−$2,600.00',  amt: -2600,   pos: false, status: 'Failed',  tone: 'vt-badge-danger' },
  { name: 'Notion',           cat: 'Software',  type: 'expenses',  acct: 'Main · USD', date: 'Jul 16, 2026', day: 16, method: 'Card',     amount: '−$96.00',     amt: -96,     pos: false, status: 'Cleared', tone: 'vt-badge-info' },
  { name: 'Client · Aster',   cat: 'Income',    type: 'income',    acct: 'Main · USD', date: 'Jul 15, 2026', day: 15, method: 'ACH',      amount: '+$5,400.00',  amt: 5400,    pos: true,  status: 'Settled', tone: 'vt-badge-success' },
  { name: 'Move → Savings',   cat: 'Transfer',  type: 'transfers', acct: 'Savings',    date: 'Jul 15, 2026', day: 15, method: 'Internal', amount: '−$3,000.00',  amt: -3000,   pos: false, status: 'Settled', tone: 'vt-badge-success' },
  { name: 'Google Workspace', cat: 'Software',  type: 'expenses',  acct: 'Main · USD', date: 'Jul 14, 2026', day: 14, method: 'Card',     amount: '−$210.00',    amt: -210,    pos: false, status: 'Cleared', tone: 'vt-badge-info' },
];
---

<FlorinShell active="transactions" title="Florin — Transactions" description="Florin transactions ledger — filter tabs, status, live search. Built with Veritheme.">
  <!-- Title + actions -->
  <div class="vt-flex vt-items-center vt-justify-between vt-gap-4">
    <div>
      <h1 class="vt-heading-md">Transactions</h1>
      <p class="vt-body-sm vt-text-foreground-muted vt-mt-1">1,284 transactions · net +$33,360 this quarter</p>
    </div>
    <div class="vt-flex vt-items-center vt-gap-2">
      <!-- Status filter: Dropdown Menu (the shell keeps it open on inner clicks) -->
      <div class="vt-dropdown-wrap vt-hidden vt-sm:flex">
        <button type="button" class="vt-btn vt-btn-bordered" data-dropdown-trigger="tx-filter-menu" aria-haspopup="menu" aria-expanded="false"><ListFilter class="vt-w-4 vt-h-4" /> Filter</button>
        <div id="tx-filter-menu" class="vt-dropdown-menu fl-menu-end" role="menu">
          <div class="vt-dropdown-label">Status</div>
          {['Settled', 'Cleared', 'Pending', 'Failed'].map((s) => (
            <label class="vt-command-item">
              <input type="checkbox" class="vt-checkbox fl-native-check" value={s.toLowerCase()} data-tx-status-filter />
              <span>{s}</span>
            </label>
          ))}
        </div>
      </div>
      <button type="button" class="vt-btn vt-btn-bordered"><Download class="vt-w-4 vt-h-4" /> Export</button>
    </div>
  </div>

  <!-- Filter bar (wired in FlorinShell) -->
  <div class="vt-flex vt-flex-wrap vt-items-center vt-justify-between vt-gap-3">
    <div class="vt-btn-group">
      {filters.map((f, i) => (
        <button type="button" class={i === 0 ? 'vt-active' : undefined} data-tx-filter={f.value}>{f.label}</button>
      ))}
    </div>
    <div class="vt-input-group fl-tx-search">
      <Search class="vt-input-icon" />
      <input class="vt-input vt-input-sm vt-pl-10" type="search" placeholder="Search merchant…" aria-label="Search transactions" data-tx-search />
    </div>
  </div>

  <!-- Ledger: Table component (frame, header band, row separators) -->
  <div class="vt-table-wrap">
    <div class="vt-overflow-x-auto">
      <table class="vt-table">
        <thead>
          <tr>
            <th scope="col" data-sort="name">
              <button type="button" class="vt-table-sort">Merchant <ArrowDownUp /></button>
            </th>
            <th scope="col" class="vt-hidden vt-md:table-cell">Account</th>
            <th scope="col" class="vt-hidden vt-md:table-cell">Method</th>
            <th scope="col" class="vt-hidden vt-md:table-cell" data-sort="day">
              <button type="button" class="vt-table-sort">Date <ArrowDownUp /></button>
            </th>
            <th scope="col">Status</th>
            <th scope="col" class="vt-table-numeric" data-sort="amount">
              <button type="button" class="vt-table-sort">Amount <ArrowDownUp /></button>
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="fl-tx-row" data-tx-row data-tx-type={r.type} data-tx-status={r.status.toLowerCase()} data-tx-name={r.name} data-sort-name={r.name} data-sort-day={r.day} data-sort-amount={r.amt} data-tx={JSON.stringify(r)}>
              <td>
                <div class="vt-flex vt-items-center vt-gap-3">
                  <div class={`vt-icon-badge vt-icon-badge-sm ${r.pos ? 'fl-tone-success' : ''}`}>
                    {r.pos ? <ArrowDownLeft class="vt-w-4 vt-h-4" /> : <ArrowUpRight class="vt-w-4 vt-h-4" />}
                  </div>
                  <div class="vt-min-w-0">
                    <p class="vt-label-md vt-truncate">{r.name}</p>
                    <p class="vt-caption vt-text-foreground-muted">{r.cat}</p>
                  </div>
                </div>
              </td>
              <td class="vt-table-muted vt-hidden vt-md:table-cell">{r.acct}</td>
              <td class="vt-table-muted vt-hidden vt-md:table-cell">{r.method}</td>
              <td class="vt-table-muted vt-whitespace-nowrap vt-hidden vt-md:table-cell">{r.date}</td>
              <td><span class={`vt-badge vt-badge-soft ${r.tone}`}>{r.status}</span></td>
              <td class={`vt-table-numeric vt-table-strong vt-whitespace-nowrap ${r.pos ? 'fl-text-success' : ''}`}>{r.amount}</td>
            </tr>
          ))}
          <tr data-tx-empty class="vt-hidden">
            <td colspan="6">
              <div class="vt-flex vt-flex-col vt-items-center vt-text-center vt-py-12">
                <div class="vt-icon-badge vt-mb-3"><SearchX class="vt-w-5 vt-h-5" /></div>
                <p class="vt-label-md">No transactions match your filters</p>
                <p class="vt-caption vt-text-foreground-muted vt-mt-1">Try a different search, or clear the filters to see everything.</p>
                <button type="button" class="vt-btn vt-btn-bordered vt-btn-sm vt-mt-4" data-tx-clear>Clear filters</button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Footer: count + pagination -->
    <div class="vt-table-footer">
      <span class="vt-hidden vt-sm:flex">Showing 1–10 of 1,284</span>
      <nav class="vt-pagination" aria-label="Pagination">
        <button type="button" class="vt-page-btn" disabled aria-label="Previous page"><ChevronLeft class="vt-w-4 vt-h-4" /></button>
        <button type="button" class="vt-page-btn vt-active" aria-current="page">1</button>
        <button type="button" class="vt-page-btn">2</button>
        <button type="button" class="vt-page-btn">3</button>
        <span class="vt-pagination-ellipsis">…</span>
        <button type="button" class="vt-page-btn vt-hidden vt-sm:flex">129</button>
        <button type="button" class="vt-page-btn" aria-label="Next page"><ChevronRight class="vt-w-4 vt-h-4" /></button>
      </nav>
    </div>
  </div>

  <!-- Transaction detail (populated on row click) -->
  <div id="tx-detail-modal" class="vt-dialog-overlay" role="dialog" aria-modal="true" aria-labelledby="tx-detail-title">
    <div class="vt-dialog">
      <div class="vt-dialog-header">
        <div class="vt-dialog-heading">
          <h3 id="tx-detail-title" data-d-name class="vt-dialog-title vt-truncate">—</h3>
          <p data-d-cat class="vt-dialog-description">—</p>
        </div>
        <span data-d-amount class="vt-heading-sm vt-whitespace-nowrap">—</span>
      </div>
      <div class="vt-dialog-body">
        <div class="vt-divide-y vt-divide-border-default vt-body-sm">
          <div class="vt-flex vt-items-center vt-justify-between vt-py-2"><span class="vt-text-foreground-muted">Date</span><span data-d-date class="vt-label-md">—</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-2"><span class="vt-text-foreground-muted">Account</span><span data-d-acct class="vt-label-md">—</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-2"><span class="vt-text-foreground-muted">Method</span><span data-d-method class="vt-label-md">—</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-2"><span class="vt-text-foreground-muted">Status</span><span data-d-status class="vt-badge vt-badge-soft">—</span></div>
        </div>
      </div>
      <div class="vt-dialog-footer">
        <button type="button" class="vt-btn vt-btn-ghost" data-modal-close>Close</button>
        <button type="button" class="vt-btn vt-btn-bordered" data-modal-close><Download class="vt-w-4 vt-h-4" /> Receipt</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var modal = document.getElementById('tx-detail-modal');
      if (!modal) return;
      function set(sel, val) { var el = modal.querySelector(sel); if (el) el.textContent = val; }
      document.querySelectorAll('[data-tx-row]').forEach(function (row) {
        row.addEventListener('click', function (e) {
          if (e.target.closest('a, button, input, label')) return; // don't hijack controls
          var d; try { d = JSON.parse(row.getAttribute('data-tx')); } catch (err) { return; }
          set('[data-d-name]', d.name); set('[data-d-cat]', d.cat);
          var amt = modal.querySelector('[data-d-amount]');
          amt.textContent = d.amount; amt.classList.toggle('fl-text-success', !!d.pos);
          set('[data-d-date]', d.date); set('[data-d-acct]', d.acct); set('[data-d-method]', d.method);
          var st = modal.querySelector('[data-d-status]');
          st.textContent = d.status; st.className = 'vt-badge vt-badge-soft ' + d.tone;
          modal.classList.add('vt-open');
        });
      });
    })();
  </script>
</FlorinShell>

<style>
  /* Ledger rows open the detail dialog; Table itself has no row hover or pointer. */
  .fl-tx-row { cursor: pointer; transition: background-color var(--vt-transition-fast); }
  .fl-tx-row:hover { background: hsl(var(--vt-surface-subtle)); }
  /* The status filters stay native inputs (the shell reads .checked); tint them with the brand. */
  .fl-native-check { accent-color: hsl(var(--vt-brand-fill)); }
  /* Search is full-width on phones and 256px from 640px up (1.2.1 has no vt-sm:w-64). */
  .fl-tx-search { width: 100%; }
  @media (min-width: 640px) {
    .fl-tx-search { width: var(--vt-spacing-64); }
  }
</style>
