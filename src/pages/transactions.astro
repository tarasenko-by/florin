---
// Florin — Transactions. Filterable ledger (filter tabs + live search are wired
// in FlorinShell's script via the data-tx-* attributes).
import FlorinShell from '../components/FlorinShell.astro';
import { Download, ListFilter, ArrowDownUp, ArrowUpRight, ArrowDownLeft, Search, SearchX, ChevronLeft, ChevronRight } from '@lucide/astro';

const filters = [
  { label: 'All',       value: 'all' },
  { label: 'Income',    value: 'income' },
  { label: 'Expenses',  value: 'expenses' },
  { label: 'Transfers', value: 'transfers' },
];

// No running-balance column: the ledger mixes accounts, so a single running
// balance would be meaningless. `type` drives the filter tabs; `day`/`amt` are
// the numeric sort keys for the sortable columns.
const rows = [
  { name: 'Stripe Payout',    cat: 'Income',   type: 'income',    acct: 'Main · USD', date: 'Jul 21, 2026', day: 21, method: 'ACH',      amount: '+$12,480.00', amt: 12480,   pos: true,  status: 'Settled', tone: 'vt-badge-success' },
  { name: 'AWS',              cat: 'Software',  type: 'expenses',  acct: 'Main · USD', date: 'Jul 20, 2026', day: 20, method: 'Card',     amount: '−$2,314.90',  amt: -2314.9, pos: false, status: 'Cleared', tone: 'vt-badge-info' },
  { name: 'Figma',            cat: 'Software',  type: 'expenses',  acct: 'Main · USD', date: 'Jul 20, 2026', day: 20, method: 'Card',     amount: '−$144.00',    amt: -144,    pos: false, status: 'Cleared', tone: 'vt-badge-info' },
  { name: 'Contractor · Lee', cat: 'Payroll',   type: 'expenses',  acct: 'Main · USD', date: 'Jul 19, 2026', day: 19, method: 'Wire',     amount: '−$4,200.00',  amt: -4200,   pos: false, status: 'Pending', tone: 'vt-badge-warning' },
  { name: 'Wire · Nord GmbH', cat: 'Income',    type: 'income',    acct: 'Main · USD', date: 'Jul 18, 2026', day: 18, method: 'Wire',     amount: '+$6,900.00',  amt: 6900,    pos: true,  status: 'Settled', tone: 'vt-badge-success' },
  { name: 'WeWork',           cat: 'Office',     type: 'expenses',  acct: 'Main · USD', date: 'Jul 17, 2026', day: 17, method: 'Card',     amount: '−$2,600.00',  amt: -2600,   pos: false, status: 'Failed',  tone: 'vt-badge-danger' },
  { name: 'Notion',           cat: 'Software',  type: 'expenses',  acct: 'Main · USD', date: 'Jul 16, 2026', day: 16, method: 'Card',     amount: '−$96.00',     amt: -96,     pos: false, status: 'Cleared', tone: 'vt-badge-info' },
  { name: 'Client · Aster',   cat: 'Income',    type: 'income',    acct: 'Main · USD', date: 'Jul 15, 2026', day: 15, method: 'ACH',      amount: '+$5,400.00',  amt: 5400,    pos: true,  status: 'Settled', tone: 'vt-badge-success' },
  { name: 'Move → Savings',   cat: 'Transfer',  type: 'transfers', acct: 'Savings',    date: 'Jul 15, 2026', day: 15, method: 'Internal', amount: '−$3,000.00',  amt: -3000,   pos: false, status: 'Settled', tone: 'vt-badge-success' },
  { name: 'Google Workspace', cat: 'Software',  type: 'expenses',  acct: 'Main · USD', date: 'Jul 14, 2026', day: 14, method: 'Card',     amount: '−$210.00',    amt: -210,    pos: false, status: 'Cleared', tone: 'vt-badge-info' },
];
---

<FlorinShell active="transactions" title="Florin — Transactions" description="Florin transactions ledger — filter tabs, status, live search. Built with Veritheme.">
  <!-- Title + actions -->
  <div class="vt-flex vt-items-center vt-justify-between vt-gap-4">
    <div>
      <h1 class="vt-text-2xl vt-font-bold">Transactions</h1>
      <p class="vt-text-sm vt-text-mains-quaternary vt-mt-1">1,284 transactions · net +$33,360 this quarter</p>
    </div>
    <div class="vt-flex vt-items-center vt-gap-2">
      <div class="vt-relative vt-hidden vt-sm:block">
        <button class="vt-btn vt-btn-bordered" data-dropdown-trigger="tx-filter-menu"><ListFilter class="vt-w-4 vt-h-4" /> Filter</button>
        <div id="tx-filter-menu" data-menu class="vt-hidden vt-absolute vt-right-0 vt-top-full vt-mt-2 vt-w-56 vt-p-1 vt-rounded-xl vt-border vt-border-border-default vt-bg-surfaces-surface vt-shadow-lg vt-z-50">
          <p class="vt-section-label vt-px-3 vt-py-2">Status</p>
          {['Settled', 'Cleared', 'Pending', 'Failed'].map((s) => (
            <label class="vt-command-item vt-cursor-pointer">
              <input type="checkbox" class="vt-checkbox" value={s.toLowerCase()} data-tx-status-filter />
              <span class="vt-text-sm">{s}</span>
            </label>
          ))}
        </div>
      </div>
      <button class="vt-btn vt-btn-bordered"><Download class="vt-w-4 vt-h-4" /> Export</button>
    </div>
  </div>

  <!-- Filter bar (wired in FlorinShell) -->
  <div class="vt-flex vt-flex-wrap vt-items-center vt-justify-between vt-gap-3">
    <div class="vt-btn-group">
      {filters.map((f, i) => (
        <button class={i === 0 ? 'vt-active' : undefined} data-tx-filter={f.value}>{f.label}</button>
      ))}
    </div>
    <div class="vt-relative vt-flex vt-items-center vt-w-full vt-sm:w-64">
      <Search class="vt-w-4 vt-h-4 vt-absolute vt-left-3 vt-text-mains-quaternary" />
      <input class="vt-input vt-input-sm vt-pl-10" type="search" placeholder="Search merchant…" aria-label="Search transactions" data-tx-search />
    </div>
  </div>

  <!-- Ledger: standalone data-table container — rounded-xl + clipped corners
       (per the Veritheme data-table component) with a surface background so it
       reads as a card rather than a transparent block on the page. -->
  <div class="vt-rounded-xl vt-border vt-border-border-default vt-bg-surfaces-surface vt-overflow-hidden">
    <div class="vt-overflow-x-auto">
      <table class="vt-w-full vt-border-collapse vt-text-sm">
        <thead>
          <tr class="vt-text-left vt-text-xs vt-text-mains-quaternary vt-bg-surfaces-subtle">
            <th class="vt-font-medium vt-px-6 vt-py-3" data-sort="name">
              <span class="vt-flex vt-items-center vt-gap-1">Merchant <ArrowDownUp class="vt-w-3 vt-h-3 vt-text-mains-quaternary" /></span>
            </th>
            <th class="vt-font-medium vt-px-6 vt-py-3 vt-hidden vt-md:table-cell">Account</th>
            <th class="vt-font-medium vt-px-6 vt-py-3 vt-hidden vt-lg:table-cell">Method</th>
            <th class="vt-font-medium vt-px-6 vt-py-3 vt-hidden vt-sm:table-cell" data-sort="day">
              <span class="vt-flex vt-items-center vt-gap-1">Date <ArrowDownUp class="vt-w-3 vt-h-3 vt-text-mains-quaternary" /></span>
            </th>
            <th class="vt-font-medium vt-px-6 vt-py-3">Status</th>
            <th class="vt-font-medium vt-px-6 vt-py-3 vt-text-right" data-sort="amount">
              <span class="vt-flex vt-items-center vt-justify-end vt-gap-1">Amount <ArrowDownUp class="vt-w-3 vt-h-3 vt-text-mains-quaternary" /></span>
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="vt-border-t vt-border-border-default vt-hover:bg-surfaces-subtle vt-transition-colors vt-cursor-pointer" data-tx-row data-tx-type={r.type} data-tx-status={r.status.toLowerCase()} data-tx-name={r.name} data-sort-name={r.name} data-sort-day={r.day} data-sort-amount={r.amt} data-tx={JSON.stringify(r)}>
              <td class="vt-px-6 vt-py-3">
                <div class="vt-flex vt-items-center vt-gap-3">
                  <div class={`vt-icon-badge vt-icon-badge-sm ${r.pos ? 'vt-text-success-primary' : 'vt-text-mains-secondary'}`}>
                    {r.pos ? <ArrowDownLeft class="vt-w-4 vt-h-4" /> : <ArrowUpRight class="vt-w-4 vt-h-4" />}
                  </div>
                  <div class="vt-min-w-0">
                    <p class="vt-font-medium vt-truncate">{r.name}</p>
                    <p class="vt-text-xs vt-text-mains-quaternary">{r.cat}</p>
                  </div>
                </div>
              </td>
              <td class="vt-px-6 vt-py-3 vt-text-mains-secondary vt-hidden vt-md:table-cell">{r.acct}</td>
              <td class="vt-px-6 vt-py-3 vt-text-mains-secondary vt-hidden vt-lg:table-cell">{r.method}</td>
              <td class="vt-px-6 vt-py-3 vt-text-mains-secondary vt-whitespace-nowrap vt-hidden vt-sm:table-cell">{r.date}</td>
              <td class="vt-px-6 vt-py-3"><span class={`vt-badge vt-badge-soft ${r.tone}`}>{r.status}</span></td>
              <td class={`vt-px-6 vt-py-3 vt-text-right vt-font-medium vt-whitespace-nowrap ${r.pos ? 'vt-text-success-primary' : ''}`}>{r.amount}</td>
            </tr>
          ))}
          <tr data-tx-empty class="vt-hidden">
            <td colspan="6" class="vt-px-6 vt-py-16 vt-text-center">
              <div class="vt-flex vt-flex-col vt-items-center">
                <div class="vt-icon-badge vt-text-mains-quaternary vt-mb-3"><SearchX class="vt-w-5 vt-h-5" /></div>
                <p class="vt-text-sm vt-font-medium">No transactions match your filters</p>
                <p class="vt-text-xs vt-text-mains-quaternary vt-mt-1">Try a different search, or clear the filters to see everything.</p>
                <button class="vt-btn vt-btn-bordered vt-btn-sm vt-mt-4" data-tx-clear>Clear filters</button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Footer: count + pagination -->
    <div class="vt-card-footer vt-flex vt-items-center vt-justify-between vt-gap-4">
      <p class="vt-text-xs vt-text-mains-quaternary vt-hidden vt-sm:block">Showing 1–10 of 1,284</p>
      <nav class="vt-flex vt-items-center vt-gap-1" aria-label="Pagination">
        <button class="vt-page-btn" disabled title="Previous page"><ChevronLeft class="vt-w-4 vt-h-4" /></button>
        <button class="vt-page-btn vt-active">1</button>
        <button class="vt-page-btn">2</button>
        <button class="vt-page-btn">3</button>
        <span class="vt-px-2 vt-text-mains-quaternary">…</span>
        <button class="vt-page-btn vt-hidden vt-sm:flex">129</button>
        <button class="vt-page-btn" title="Next page"><ChevronRight class="vt-w-4 vt-h-4" /></button>
      </nav>
    </div>
  </div>

  <!-- Transaction detail (populated on row click) -->
  <div id="tx-detail-modal" class="vt-dialog-overlay" role="dialog" aria-modal="true" aria-labelledby="tx-detail-title">
    <div class="vt-dialog">
      <div class="vt-p-6">
        <div class="vt-flex vt-items-start vt-justify-between vt-gap-4">
          <div class="vt-min-w-0">
            <h3 id="tx-detail-title" data-d-name class="vt-text-lg vt-font-semibold vt-truncate">—</h3>
            <p data-d-cat class="vt-text-sm vt-text-mains-quaternary vt-mt-0.5">—</p>
          </div>
          <span data-d-amount class="vt-text-xl vt-font-bold vt-whitespace-nowrap">—</span>
        </div>
        <div class="vt-divide-y vt-divide-border-default vt-mt-5 vt-text-sm">
          <div class="vt-flex vt-items-center vt-justify-between vt-py-2"><span class="vt-text-mains-quaternary">Date</span><span data-d-date class="vt-font-medium">—</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-2"><span class="vt-text-mains-quaternary">Account</span><span data-d-acct class="vt-font-medium">—</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-2"><span class="vt-text-mains-quaternary">Method</span><span data-d-method class="vt-font-medium">—</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-2"><span class="vt-text-mains-quaternary">Status</span><span data-d-status class="vt-badge vt-badge-soft">—</span></div>
        </div>
      </div>
      <div class="vt-flex vt-justify-end vt-gap-2 vt-p-6 vt-pt-0">
        <button class="vt-btn vt-btn-ghost" data-modal-close>Close</button>
        <button class="vt-btn vt-btn-bordered" data-modal-close><Download class="vt-w-4 vt-h-4" /> Receipt</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var modal = document.getElementById('tx-detail-modal');
      if (!modal) return;
      function set(sel, val) { var el = modal.querySelector(sel); if (el) el.textContent = val; }
      document.querySelectorAll('[data-tx-row]').forEach(function (row) {
        row.addEventListener('click', function (e) {
          if (e.target.closest('a, button, input, label')) return; // don't hijack controls
          var d; try { d = JSON.parse(row.getAttribute('data-tx')); } catch (err) { return; }
          set('[data-d-name]', d.name); set('[data-d-cat]', d.cat);
          var amt = modal.querySelector('[data-d-amount]');
          amt.textContent = d.amount; amt.classList.toggle('vt-text-success-primary', !!d.pos);
          set('[data-d-date]', d.date); set('[data-d-acct]', d.acct); set('[data-d-method]', d.method);
          var st = modal.querySelector('[data-d-status]');
          st.textContent = d.status; st.className = 'vt-badge vt-badge-soft ' + d.tone;
          modal.classList.add('vt-open');
        });
      });
    })();
  </script>
</FlorinShell>
