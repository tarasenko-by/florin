---
// Florin — Help center. Search, topics, popular articles, contact.
import FlorinShell from '../components/FlorinShell.astro';
import {
  Search, BookOpen, Wallet, Send, Shield, CreditCard, FileText, MessageCircle,
  Mail, ArrowRight, ChevronRight, ChevronDown,
} from '@lucide/astro';

const topics = [
  { icon: BookOpen,   title: 'Getting started',      desc: 'Open an account, verify, invite your team.', count: '12 articles' },
  { icon: Wallet,     title: 'Accounts & cards',     desc: 'Balances, statements, freezing and limits.', count: '18 articles' },
  { icon: Send,       title: 'Payments & transfers', desc: 'Send money, schedule and recurring payments.', count: '15 articles' },
  { icon: Shield,     title: 'Security',             desc: 'Two-factor, devices, and account recovery.', count: '9 articles' },
  { icon: CreditCard, title: 'Billing & plans',      desc: 'Your plan, payment method, and invoices.', count: '7 articles' },
  { icon: FileText,   title: 'Statements & tax',     desc: 'Export statements and tax documents.', count: '6 articles' },
];

const popular = [
  'How do I open a new account?',
  'When do transfers settle?',
  'Set up two-factor authentication',
  'Freeze or replace a card',
  'Download statements for tax',
];

const contactTopics = ['Payments & transfers', 'Accounts & cards', 'Security', 'Billing & plans', 'Something else'];
---

<FlorinShell active="help" title="Florin — Help center" description="Florin help center — search, topics, and support. Built with Veritheme.">
  <!-- Hero + search -->
  <div class="vt-text-center vt-py-6">
    <h1 class="vt-heading-md">How can we help?</h1>
    <p class="vt-body-sm vt-text-foreground-muted vt-mt-2">Search our guides or browse by topic.</p>
    <div class="vt-input-group vt-max-w-xl vt-mx-auto vt-mt-5">
      <Search class="vt-input-icon" aria-hidden="true" />
      <input class="vt-input" type="search" placeholder="Search for help…" aria-label="Search help" />
    </div>
  </div>

  <!-- Topics: interactive cards (hover border from the Card component) -->
  <div class="vt-grid vt-grid-cols-1 vt-sm:grid-cols-2 vt-lg:grid-cols-3 vt-gap-4">
    {topics.map((t) => (
      <a href="#" class="vt-card vt-card-interactive">
        <div class="vt-card-body vt-h-full vt-flex vt-flex-col vt-gap-4">
          <div class="vt-icon-badge fl-tone-brand"><t.icon class="vt-icon-badge-icon" /></div>
          <div>
            <h3 class="vt-card-title">{t.title}</h3>
            <p class="vt-card-description">{t.desc}</p>
          </div>
          <p class="vt-caption vt-text-foreground-muted vt-mt-auto">{t.count}</p>
        </div>
      </a>
    ))}
  </div>

  <!-- Popular + contact -->
  <div class="fl-split vt-items-start">
    <section class="fl-span-2 vt-card" aria-labelledby="popular-title">
      <div class="vt-card-header">
        <h2 id="popular-title" class="vt-card-title">Popular articles</h2>
      </div>
      <nav class="fl-card-rows vt-divide-y vt-divide-border-default" aria-labelledby="popular-title">
        {popular.map((a) => (
          <a href="#" class="vt-list-item">
            <span class="vt-list-item-title vt-truncate">{a}</span>
            <ChevronRight class="vt-list-item-chevron" />
          </a>
        ))}
      </nav>
    </section>

    <section class="vt-card" aria-labelledby="contact-card-title">
      <div class="vt-card-body">
        <h2 id="contact-card-title" class="vt-card-title">Still stuck?</h2>
        <p class="vt-card-description">Our team replies within a few hours.</p>
        <div class="vt-space-y-2 vt-mt-5">
          <button type="button" class="vt-btn vt-btn-primary vt-w-full" data-modal-open="contact-modal"><MessageCircle class="vt-w-4 vt-h-4" /> Start a chat</button>
          <button type="button" class="vt-btn vt-btn-bordered vt-w-full" data-modal-open="contact-modal"><Mail class="vt-w-4 vt-h-4" /> Email support</button>
        </div>
        <a href="#" class="vt-link vt-mt-5">Read the docs <ArrowRight /></a>
      </div>
    </section>
  </div>

  <!-- Contact support -->
  <div id="contact-modal" class="vt-dialog-overlay" role="dialog" aria-modal="true" aria-labelledby="contact-title" aria-describedby="contact-desc">
    <div class="vt-dialog vt-overflow-visible">
      <div class="vt-dialog-header">
        <div class="vt-dialog-heading">
          <h3 id="contact-title" class="vt-dialog-title">Contact support</h3>
          <p id="contact-desc" class="vt-dialog-description">Tell us what's going on — we usually reply within a few hours.</p>
        </div>
      </div>
      <div class="vt-dialog-body">
        <div class="vt-field">
          <span class="vt-label" id="contact-topic-label">Topic</span>
          <div class="vt-relative" data-select>
            <button type="button" class="vt-select-trigger" aria-haspopup="listbox" aria-labelledby="contact-topic-label contact-topic-value">
              <span id="contact-topic-value" data-select-label>{contactTopics[0]}</span>
              <ChevronDown class="vt-w-4 vt-h-4 vt-text-foreground-muted" />
            </button>
            <div class="vt-select-dropdown" role="listbox" aria-labelledby="contact-topic-label">
              {contactTopics.map((topic, i) => (
                <div class="vt-select-item" role="option" aria-selected={i === 0 ? 'true' : undefined}>{topic}</div>
              ))}
            </div>
          </div>
        </div>
        <div class="vt-field">
          <label class="vt-label" for="contact-msg">Message</label>
          <textarea id="contact-msg" class="vt-textarea" rows="4" placeholder="Describe your issue…"></textarea>
        </div>
      </div>
      <div class="vt-dialog-footer">
        <button type="button" class="vt-btn vt-btn-ghost" data-modal-close>Cancel</button>
        <button type="button" class="vt-btn vt-btn-primary" data-modal-close><Send class="vt-w-4 vt-h-4" /> Send message</button>
      </div>
    </div>
  </div>
</FlorinShell>

<style>
  /* List Item rows sit flush in the card (no List frame inside a card), so
     they take the card header's 24px inset and the text lines up with it. */
  .fl-card-rows > .vt-list-item {
    padding-inline: var(--vt-spacing-6);
  }
</style>
