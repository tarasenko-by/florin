---
// Florin — Transfer. Send-money form with review summary and recent recipients.
import FlorinShell from '../components/FlorinShell.astro';
import { ChevronDown, Send, ArrowRight } from '@lucide/astro';
import { FACES } from '../data/images';

const recipients = [
  { name: 'Nord GmbH',      detail: 'DE89 •••• 4021', face: 'MK' as const },
  { name: 'Aster Studio',   detail: 'ACH •••• 8830', face: 'TW' as const },
  { name: 'Lee Contractor', detail: 'Wire •••• 1192', face: 'JR' as const },
];

// Select fields (shell contract: [data-select] wrapper, button trigger,
// [data-select-label], .vt-select-item rows; the first item is the default).
const accounts = ['Main · USD — $84,140.00', 'Savings — $31,500.00', 'Tax reserve — $12,900.00'];
const payees = recipients.map((r) => `${r.name} — ${r.detail}`);
const currencies = ['USD — US Dollar', 'EUR — Euro', 'GBP — British Pound'];
---

<FlorinShell active="transfer" title="Florin — Transfer" description="Florin transfer — send money with a review step and recent recipients. Built with Veritheme.">
  <div>
    <h1 class="vt-heading-md">Send money</h1>
    <p class="vt-body-sm vt-text-foreground-muted vt-mt-1">Transfer between accounts or pay someone new.</p>
  </div>

  <div class="fl-split">
    <!-- Form (overflow-visible so select dropdowns aren't clipped by the card) -->
    <div class="fl-span-2 vt-card vt-overflow-visible">
      <div class="vt-card-header">
        <h2 class="vt-label-md">Transfer details</h2>
        <p class="vt-caption vt-text-foreground-muted vt-mt-0.5">Funds usually arrive within 1 business day.</p>
      </div>
      <div class="vt-card-body vt-space-y-4">
        <div>
          <label class="vt-label vt-mb-1.5 vt-block" for="from-account">From account</label>
          <div class="vt-relative" data-select>
            <button type="button" id="from-account" class="vt-select-trigger" aria-haspopup="listbox">
              <span data-select-label>{accounts[0]}</span>
              <ChevronDown class="vt-w-4 vt-h-4 vt-text-foreground-muted" />
            </button>
            <div class="vt-select-dropdown" role="listbox">
              {accounts.map((a, i) => <div class="vt-select-item" role="option" aria-selected={i === 0 ? 'true' : undefined}>{a}</div>)}
            </div>
          </div>
        </div>

        <div>
          <label class="vt-label vt-mb-1.5 vt-block" for="recipient">Recipient</label>
          <div class="vt-relative" data-select>
            <button type="button" id="recipient" class="vt-select-trigger" aria-haspopup="listbox">
              <span data-select-label data-recipient-target>{payees[0]}</span>
              <ChevronDown class="vt-w-4 vt-h-4 vt-text-foreground-muted" />
            </button>
            <div class="vt-select-dropdown" role="listbox">
              {payees.map((p, i) => <div class="vt-select-item" role="option" aria-selected={i === 0 ? 'true' : undefined}>{p}</div>)}
            </div>
          </div>
        </div>

        <div class="vt-grid vt-grid-cols-1 vt-sm:grid-cols-2 vt-gap-4">
          <div>
            <label class="vt-label vt-mb-1.5 vt-block" for="amount">Amount</label>
            <input id="amount" class="vt-input" type="text" value="$5,000.00" inputmode="decimal" />
          </div>
          <div>
            <label class="vt-label vt-mb-1.5 vt-block" for="currency">Currency</label>
            <div class="vt-relative" data-select>
              <button type="button" id="currency" class="vt-select-trigger" aria-haspopup="listbox">
                <span data-select-label>{currencies[0]}</span>
                <ChevronDown class="vt-w-4 vt-h-4 vt-text-foreground-muted" />
              </button>
              <div class="vt-select-dropdown" role="listbox">
                {currencies.map((c, i) => <div class="vt-select-item" role="option" aria-selected={i === 0 ? 'true' : undefined}>{c}</div>)}
              </div>
            </div>
          </div>
        </div>

        <div>
          <label class="vt-label vt-mb-1.5 vt-block" for="note">Note (optional)</label>
          <textarea id="note" class="vt-textarea" rows="2" placeholder="What's this for?">Invoice #2048 — July retainer</textarea>
        </div>
      </div>
      <div class="vt-card-footer">
        <button type="button" class="vt-btn vt-btn-ghost" data-form-clear>Clear</button>
        <button type="button" class="vt-btn vt-btn-primary" data-modal-open="review-send-modal"><Send class="vt-w-4 vt-h-4" /> Review &amp; send</button>
      </div>
    </div>

    <!-- Summary + recipients -->
    <div class="vt-space-y-6">
      <div class="vt-card">
        <div class="vt-card-body">
          <h2 class="vt-label-md">Summary</h2>
          <div class="vt-space-y-3 vt-mt-4">
            <div class="vt-flex vt-items-center vt-justify-between"><span class="vt-text-foreground-muted">Amount</span><span class="vt-label-md">$5,000.00</span></div>
            <div class="vt-flex vt-items-center vt-justify-between"><span class="vt-text-foreground-muted">Fee</span><span class="vt-label-md">$0.00</span></div>
            <div class="vt-flex vt-items-center vt-justify-between"><span class="vt-text-foreground-muted">Arrives</span><span class="vt-label-md">Jul 22</span></div>
            <div class="vt-separator vt-separator-h" role="separator"></div>
            <div class="vt-flex vt-items-center vt-justify-between"><span class="vt-label-md">Total</span><span class="vt-label-lg">$5,000.00</span></div>
          </div>
        </div>
      </div>

      <!-- Recent recipients: List Item rows; a click picks the recipient above -->
      <div class="vt-card">
        <div class="vt-card-header">
          <h2 class="vt-label-md">Recent recipients</h2>
        </div>
        <div class="vt-flex vt-flex-col vt-py-2">
          {recipients.map((r) => (
            <button type="button" class="vt-list-item vt-w-full vt-text-left" data-recipient={`${r.name} — ${r.detail}`}>
              <div class="vt-avatar vt-avatar-sm"><img src={FACES[r.face]} alt="" /></div>
              <div class="vt-list-item-content">
                <span class="vt-list-item-title vt-truncate">{r.name}</span>
                <span class="vt-list-item-description vt-truncate">{r.detail}</span>
              </div>
              <ArrowRight class="vt-list-item-chevron" />
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Review & send confirmation -->
  <div id="review-send-modal" class="vt-dialog-overlay" role="dialog" aria-modal="true" aria-labelledby="review-send-title">
    <div class="vt-dialog">
      <div class="vt-dialog-header">
        <div class="vt-dialog-heading">
          <h3 id="review-send-title" class="vt-dialog-title">Review transfer</h3>
          <p class="vt-dialog-description">Check the details before sending.</p>
        </div>
      </div>
      <div class="vt-dialog-body">
        <div class="vt-divide-y vt-divide-border-default vt-body-sm">
          <div class="vt-flex vt-items-center vt-justify-between vt-gap-4 vt-py-3"><span class="vt-text-foreground-muted">To</span><span class="vt-label-md vt-text-right" data-recipient-target-echo>Nord GmbH</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-3"><span class="vt-text-foreground-muted">From</span><span class="vt-label-md">Main · USD</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-3"><span class="vt-text-foreground-muted">Amount</span><span class="vt-label-md">$5,000.00</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-3"><span class="vt-text-foreground-muted">Fee</span><span class="vt-label-md">$0.00</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-3"><span class="vt-label-md">Total</span><span class="vt-label-lg">$5,000.00</span></div>
        </div>
      </div>
      <div class="vt-dialog-footer">
        <button type="button" class="vt-btn vt-btn-ghost" data-modal-close>Cancel</button>
        <button type="button" class="vt-btn vt-btn-primary" data-modal-close><Send class="vt-w-4 vt-h-4" /> Send $5,000.00</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var target = document.querySelector('[data-recipient-target]');
      if (!target) return;
      var select = target.closest('[data-select]');
      var echo = document.querySelector('[data-recipient-target-echo]');
      // A recent recipient sets the Recipient select (label + selected option).
      document.querySelectorAll('[data-recipient]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var value = btn.getAttribute('data-recipient');
          target.textContent = value;
          if (select) select.querySelectorAll('.vt-select-item').forEach(function (item) {
            if (item.textContent.trim() === value) item.setAttribute('aria-selected', 'true');
            else item.removeAttribute('aria-selected');
          });
        });
      });
      // The review dialog shows whoever is picked when it opens.
      var review = document.querySelector('[data-modal-open="review-send-modal"]');
      if (review && echo) review.addEventListener('click', function () {
        echo.textContent = target.textContent.split(' — ')[0];
      });
    })();
  </script>
</FlorinShell>
