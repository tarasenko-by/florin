---
// Florin — Transfer. Send-money form with review summary and recent recipients.
import FlorinShell from '../components/FlorinShell.astro';
import { ChevronDown, Send, ArrowRight } from '@lucide/astro';
import { FACES } from '../data/images';

const recipients = [
  { name: 'Nord GmbH',      detail: 'DE89 •••• 4021', face: 'MK' as const },
  { name: 'Aster Studio',   detail: 'ACH •••• 8830', face: 'TW' as const },
  { name: 'Lee Contractor', detail: 'Wire •••• 1192', face: 'JR' as const },
];
---

<FlorinShell active="transfer" title="Florin — Transfer" description="Florin transfer — send money with a review step and recent recipients. Built with Veritheme.">
  <div>
    <h1 class="vt-text-2xl vt-font-bold">Send money</h1>
    <p class="vt-text-sm vt-text-mains-quaternary vt-mt-1">Transfer between accounts or pay someone new.</p>
  </div>

  <div class="vt-grid vt-grid-cols-1 vt-lg:grid-cols-3 vt-gap-6">
    <!-- Form (overflow-visible so select dropdowns aren't clipped by the card) -->
    <div class="vt-lg:col-span-2 vt-card vt-overflow-visible">
      <div class="vt-card-header">
        <h2 class="vt-text-sm vt-font-semibold">Transfer details</h2>
        <p class="vt-text-xs vt-text-mains-quaternary vt-mt-0.5">Funds usually arrive within 1 business day.</p>
      </div>
      <div class="vt-p-6 vt-space-y-4">
        <div>
          <label class="vt-label vt-mb-1.5 vt-block">From account</label>
          <div class="vt-select-wrapper vt-relative">
            <div class="vt-select-trigger">
              <span data-select-label>Main · USD — $84,140.00</span>
              <ChevronDown class="vt-w-4 vt-h-4 vt-text-mains-quaternary" />
            </div>
            <div class="vt-select-dropdown">
              <div class="vt-select-item" aria-selected="true">Main · USD — $84,140.00</div>
              <div class="vt-select-item">Savings — $31,500.00</div>
              <div class="vt-select-item">Tax reserve — $12,900.00</div>
            </div>
          </div>
        </div>

        <div>
          <label class="vt-label vt-mb-1.5 vt-block">Recipient</label>
          <div class="vt-select-wrapper vt-relative">
            <div class="vt-select-trigger">
              <span data-select-label data-recipient-target>Nord GmbH — DE89 •••• 4021</span>
              <ChevronDown class="vt-w-4 vt-h-4 vt-text-mains-quaternary" />
            </div>
            <div class="vt-select-dropdown">
              <div class="vt-select-item" aria-selected="true">Nord GmbH — DE89 •••• 4021</div>
              <div class="vt-select-item">Aster Studio — ACH •••• 8830</div>
              <div class="vt-select-item">Lee Contractor — Wire •••• 1192</div>
            </div>
          </div>
        </div>

        <div class="vt-grid vt-grid-cols-1 vt-sm:grid-cols-2 vt-gap-4">
          <div>
            <label class="vt-label vt-mb-1.5 vt-block" for="amount">Amount</label>
            <input id="amount" class="vt-input" type="text" value="$5,000.00" inputmode="decimal" />
          </div>
          <div>
            <label class="vt-label vt-mb-1.5 vt-block">Currency</label>
            <div class="vt-select-wrapper vt-relative">
              <div class="vt-select-trigger">
                <span data-select-label>USD — US Dollar</span>
                <ChevronDown class="vt-w-4 vt-h-4 vt-text-mains-quaternary" />
              </div>
              <div class="vt-select-dropdown">
                <div class="vt-select-item" aria-selected="true">USD — US Dollar</div>
                <div class="vt-select-item">EUR — Euro</div>
                <div class="vt-select-item">GBP — British Pound</div>
              </div>
            </div>
          </div>
        </div>

        <div>
          <label class="vt-label vt-mb-1.5 vt-block" for="note">Note (optional)</label>
          <textarea id="note" class="vt-textarea" rows="2" placeholder="What's this for?">Invoice #2048 — July retainer</textarea>
        </div>
      </div>
      <div class="vt-card-footer vt-flex vt-items-center vt-justify-end vt-gap-2">
        <button class="vt-btn vt-btn-ghost" data-form-clear>Clear</button>
        <button class="vt-btn vt-btn-primary" data-modal-open="review-send-modal"><Send class="vt-w-4 vt-h-4" /> Review &amp; send</button>
      </div>
    </div>

    <!-- Summary + recipients -->
    <div class="vt-space-y-6">
      <div class="vt-card vt-p-6">
        <h2 class="vt-text-sm vt-font-semibold">Summary</h2>
        <div class="vt-space-y-3 vt-mt-4 vt-text-sm">
          <div class="vt-flex vt-items-center vt-justify-between"><span class="vt-text-mains-quaternary">Amount</span><span class="vt-font-medium">$5,000.00</span></div>
          <div class="vt-flex vt-items-center vt-justify-between"><span class="vt-text-mains-quaternary">Fee</span><span class="vt-font-medium">$0.00</span></div>
          <div class="vt-flex vt-items-center vt-justify-between"><span class="vt-text-mains-quaternary">Arrives</span><span class="vt-font-medium">Jul 22</span></div>
          <div class="vt-separator vt-my-1"></div>
          <div class="vt-flex vt-items-center vt-justify-between"><span class="vt-font-medium">Total</span><span class="vt-text-base vt-font-bold">$5,000.00</span></div>
        </div>
      </div>

      <div class="vt-card vt-p-6">
        <h2 class="vt-text-sm vt-font-semibold">Recent recipients</h2>
        <div class="vt-space-y-1 vt-mt-4">
          {recipients.map((r) => (
            <button class="vt-flex vt-items-center vt-gap-3 vt-w-full vt-text-left vt-rounded-xl vt-p-2 vt-transition-colors vt-hover:bg-surfaces-subtle" data-recipient={`${r.name} — ${r.detail}`}>
              <div class="vt-avatar vt-avatar-sm"><img src={FACES[r.face]} alt={r.name} /></div>
              <div class="vt-min-w-0 vt-flex-1">
                <p class="vt-text-sm vt-font-medium vt-truncate">{r.name}</p>
                <p class="vt-text-xs vt-text-mains-quaternary vt-truncate">{r.detail}</p>
              </div>
              <ArrowRight class="vt-w-4 vt-h-4 vt-text-mains-quaternary" />
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Review & send confirmation -->
  <div id="review-send-modal" class="vt-dialog-overlay" role="dialog" aria-modal="true" aria-labelledby="review-send-title">
    <div class="vt-dialog">
      <div class="vt-p-6">
        <h3 id="review-send-title" class="vt-text-lg vt-font-semibold">Review transfer</h3>
        <p class="vt-text-sm vt-text-mains-quaternary vt-mt-1.5">Check the details before sending.</p>
        <div class="vt-divide-y vt-divide-border-default vt-mt-5 vt-text-sm">
          <div class="vt-flex vt-items-center vt-justify-between vt-py-3"><span class="vt-text-mains-quaternary">To</span><span class="vt-font-medium" data-recipient-target-echo>Nord GmbH</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-3"><span class="vt-text-mains-quaternary">From</span><span class="vt-font-medium">Main · USD</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-3"><span class="vt-text-mains-quaternary">Amount</span><span class="vt-font-medium">$5,000.00</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-3"><span class="vt-text-mains-quaternary">Fee</span><span class="vt-font-medium">$0.00</span></div>
          <div class="vt-flex vt-items-center vt-justify-between vt-py-3"><span class="vt-font-medium">Total</span><span class="vt-text-base vt-font-bold">$5,000.00</span></div>
        </div>
      </div>
      <div class="vt-flex vt-justify-end vt-gap-2 vt-p-6 vt-pt-0">
        <button class="vt-btn vt-btn-ghost" data-modal-close>Cancel</button>
        <button class="vt-btn vt-btn-primary" data-modal-close><Send class="vt-w-4 vt-h-4" /> Send $5,000.00</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var target = document.querySelector('[data-recipient-target]');
      if (!target) return;
      document.querySelectorAll('[data-recipient]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          target.textContent = btn.getAttribute('data-recipient');
        });
      });
    })();
  </script>
</FlorinShell>
