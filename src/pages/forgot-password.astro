---
// Florin — Reset password. Single email field, links back to sign in.
import FlorinAuth from '../components/FlorinAuth.astro';
import { ArrowLeft } from '@lucide/astro';
---

<FlorinAuth title="Florin — Reset password" description="Reset your Florin password — a fintech dashboard template built with Veritheme.">
  <div class="vt-mb-6">
    <h1 class="vt-text-2xl vt-font-bold">Reset your password</h1>
    <p class="vt-text-sm vt-text-mains-quaternary vt-mt-1">Enter your email and we'll send you a reset link.</p>
  </div>

  <form class="vt-space-y-4">
    <div>
      <label class="vt-label vt-mb-1.5 vt-block" for="email">Email</label>
      <input id="email" type="email" autocomplete="email" placeholder="you@company.com" class="vt-input" />
    </div>
    <a href="/login" class="vt-btn vt-btn-primary vt-w-full">Send reset link</a>
  </form>

  <a href="/login" class="vt-flex vt-items-center vt-justify-center vt-gap-1.5 vt-text-sm vt-text-mains-quaternary vt-mt-6 vt-hover:text-mains-primary vt-transition-colors">
    <ArrowLeft class="vt-w-4 vt-h-4" /> Back to sign in
  </a>
</FlorinAuth>
