---
// Florin — Reset password. Auth split (FlorinAuth): one email field, back to sign in.
import FlorinAuth from '../components/FlorinAuth.astro';
import { ArrowLeft } from '@lucide/astro';
---

<FlorinAuth
  title="Florin — Reset password"
  description="Reset your Florin password — a fintech dashboard template built with Veritheme."
  heading="Reset your password"
  lede="Enter your email and we'll send you a reset link."
>
  <form class="vt-form">
    <div class="vt-field">
      <label class="vt-label" for="email">Email</label>
      <input id="email" type="email" autocomplete="email" placeholder="you@company.com" class="vt-input" />
    </div>
    <div class="vt-form-actions vt-form-actions-block">
      <a href="/login" class="vt-btn vt-btn-primary"><span>Send reset link</span></a>
    </div>
  </form>

  <p class="vt-auth-footer">
    <a href="/login" class="vt-link vt-link-muted"><ArrowLeft /> Back to sign in</a>
  </p>
</FlorinAuth>
