---
// Florin — Settings. Section nav, profile form, notification switches, danger zone.
import FlorinShell from '../components/FlorinShell.astro';
import { User, Bell, Shield, ChevronDown, Upload, Trash2, TriangleAlert } from '@lucide/astro';
import { FACES } from '../data/images';

const sections = [
  { label: 'Profile',       icon: User,   href: '#profile',       active: true },
  { label: 'Notifications', icon: Bell,   href: '#notifications', active: false },
  { label: 'Security',      icon: Shield, href: '#security',      active: false },
];

const notifications = [
  { id: 'incoming', title: 'Incoming payments',  desc: 'Get notified when money lands in any account.', on: true },
  { id: 'large',    title: 'Large transactions', desc: 'Alert on any transaction over $2,000.',          on: true },
  { id: 'weekly',   title: 'Weekly summary',     desc: 'A Monday digest of cash flow and balances.',      on: false },
  { id: 'product',  title: 'Product updates',    desc: 'New features and occasional tips.',               on: false },
];
---

<FlorinShell active="settings" title="Florin — Settings" description="Florin settings — profile, notifications, security, danger zone. Built with Veritheme.">
  <div>
    <h1 class="vt-heading-md">Settings</h1>
    <p class="vt-body-sm vt-text-foreground-muted vt-mt-1">Manage your profile, alerts, and security.</p>
  </div>

  <div class="vt-flex vt-flex-col vt-md:flex-row vt-gap-8">
    <!-- Section nav -->
    <nav class="vt-md:w-56 vt-flex-shrink-0 vt-space-y-0.5" aria-label="Settings sections">
      {sections.map((s) => (
        <a href={s.href} class:list={['vt-nav-item', { 'vt-active': s.active }]}>
          <s.icon class="vt-nav-item-icon" /> {s.label}
        </a>
      ))}
    </nav>

    <!-- Content -->
    <div class="vt-flex-1 vt-min-w-0 vt-space-y-6">
      <!-- Profile (overflow-visible so the Business select dropdown isn't clipped by the card) -->
      <section id="profile" class="vt-card vt-overflow-visible" data-dirty-form aria-labelledby="profile-title">
        <div class="vt-card-header">
          <h2 id="profile-title" class="vt-card-title">Profile</h2>
          <p class="vt-card-description">How you appear across Florin.</p>
        </div>
        <div class="vt-card-body vt-space-y-4">
          <div class="vt-flex vt-items-center vt-gap-4">
            <div class="vt-avatar vt-avatar-xl"><img src={FACES.SL} alt="Sofia Marchetti" /></div>
            <div class="vt-flex vt-items-center vt-gap-2">
              <button type="button" class="vt-btn vt-btn-bordered vt-btn-sm"><Upload class="vt-w-4 vt-h-4" /> Upload</button>
              <button type="button" class="vt-btn vt-btn-ghost vt-btn-sm fl-text-error">Remove</button>
            </div>
          </div>
          <div class="vt-grid vt-grid-cols-1 vt-sm:grid-cols-2 vt-gap-4">
            <div class="vt-field">
              <label class="vt-label" for="fn">Full name</label>
              <input id="fn" class="vt-input" type="text" value="Sofia Marchetti" />
            </div>
            <div class="vt-field">
              <label class="vt-label" for="em">Email</label>
              <input id="em" class="vt-input" type="email" value="sofia@nordstudio.co" />
            </div>
          </div>
          <div class="vt-field">
            <span class="vt-label" id="biz-label">Business</span>
            <div class="vt-relative" data-select>
              <button type="button" class="vt-select-trigger" aria-haspopup="listbox" aria-labelledby="biz-label biz-value">
                <span id="biz-value" data-select-label>Nord Studio LLC</span>
                <ChevronDown class="vt-w-4 vt-h-4 vt-text-foreground-muted" />
              </button>
              <div class="vt-select-dropdown" role="listbox" aria-labelledby="biz-label">
                <div class="vt-select-item" role="option" aria-selected="true">Nord Studio LLC</div>
                <div class="vt-select-item" role="option">Nord Studio GmbH</div>
                <div class="vt-select-item" role="option">Add a business…</div>
              </div>
            </div>
          </div>
        </div>
        <div class="vt-card-footer">
          <button type="button" class="vt-btn vt-btn-primary" data-dirty-save disabled>Save changes</button>
        </div>
      </section>

      <!-- Notifications -->
      <section id="notifications" class="vt-card" aria-labelledby="notifications-title">
        <div class="vt-card-header">
          <h2 id="notifications-title" class="vt-card-title">Notifications</h2>
          <p class="vt-card-description">Choose what Florin pings you about.</p>
        </div>
        <div class="vt-card-body vt-space-y-5">
          {notifications.map((n) => (
            <div class="vt-flex vt-items-center vt-justify-between vt-gap-4">
              <div class="vt-min-w-0">
                <p id={`notif-${n.id}`} class="vt-label-md">{n.title}</p>
                <p class="vt-caption vt-text-foreground-muted vt-mt-0.5">{n.desc}</p>
              </div>
              <button
                type="button"
                role="switch"
                aria-checked={n.on ? 'true' : 'false'}
                aria-labelledby={`notif-${n.id}`}
                class:list={['vt-switch vt-flex-shrink-0', { 'vt-active': n.on }]}
              >
                <span class="vt-switch-thumb"></span>
              </button>
            </div>
          ))}
        </div>
      </section>

      <!-- Security -->
      <section id="security" class="vt-card" aria-labelledby="security-title">
        <div class="vt-card-header">
          <h2 id="security-title" class="vt-card-title">Security</h2>
          <p class="vt-card-description">Protect your account and sessions.</p>
        </div>
        <div class="vt-card-body vt-space-y-5">
          <div class="vt-flex vt-items-center vt-justify-between vt-gap-4">
            <div class="vt-min-w-0">
              <p id="sec-2fa" class="vt-label-md">Two-factor authentication</p>
              <p class="vt-caption vt-text-foreground-muted vt-mt-0.5">Require a code at sign-in.</p>
            </div>
            <button type="button" role="switch" aria-checked="true" aria-labelledby="sec-2fa" class="vt-switch vt-flex-shrink-0 vt-active"><span class="vt-switch-thumb"></span></button>
          </div>
          <div class="vt-flex vt-items-center vt-justify-between vt-gap-4">
            <div class="vt-min-w-0">
              <p class="vt-label-md">Password</p>
              <p class="vt-caption vt-text-foreground-muted vt-mt-0.5">Last changed 3 months ago.</p>
            </div>
            <button type="button" class="vt-btn vt-btn-bordered vt-btn-sm vt-flex-shrink-0" data-modal-open="change-password-modal">Change password</button>
          </div>
        </div>
      </section>

      <!-- Danger zone -->
      <section class="vt-card vt-border-error-fill" aria-labelledby="danger-title">
        <div class="vt-card-header vt-border-error-fill">
          <h2 id="danger-title" class="vt-card-title fl-text-error">Danger zone</h2>
        </div>
        <div class="vt-card-body vt-flex vt-flex-col vt-sm:flex-row vt-sm:items-center vt-justify-between vt-gap-4">
          <div>
            <p class="vt-label-md">Close this account</p>
            <p class="vt-caption vt-text-foreground-muted vt-mt-0.5">Permanently close Florin and export your data.</p>
          </div>
          <button type="button" class="vt-btn vt-btn-danger vt-flex-shrink-0" data-modal-open="close-account-modal"><Trash2 class="vt-w-4 vt-h-4" /> Close account</button>
        </div>
      </section>
    </div>
  </div>

  <!-- Change password -->
  <div id="change-password-modal" class="vt-dialog-overlay" role="dialog" aria-modal="true" aria-labelledby="change-password-title" aria-describedby="change-password-desc">
    <div class="vt-dialog">
      <div class="vt-dialog-header">
        <div class="vt-dialog-heading">
          <h3 id="change-password-title" class="vt-dialog-title">Change password</h3>
          <p id="change-password-desc" class="vt-dialog-description">Use at least 12 characters.</p>
        </div>
      </div>
      <div class="vt-dialog-body">
        <div class="vt-field">
          <label class="vt-label" for="pw-current">Current password</label>
          <input id="pw-current" class="vt-input" type="password" autocomplete="current-password" placeholder="••••••••" />
        </div>
        <div class="vt-field">
          <label class="vt-label" for="pw-new">New password</label>
          <input id="pw-new" class="vt-input" type="password" autocomplete="new-password" placeholder="••••••••" />
        </div>
        <div class="vt-field">
          <label class="vt-label" for="pw-confirm">Confirm new password</label>
          <input id="pw-confirm" class="vt-input" type="password" autocomplete="new-password" placeholder="••••••••" />
        </div>
      </div>
      <div class="vt-dialog-footer">
        <button type="button" class="vt-btn vt-btn-ghost" data-modal-close>Cancel</button>
        <button type="button" class="vt-btn vt-btn-primary" data-modal-close>Update password</button>
      </div>
    </div>
  </div>

  <!-- Close-account confirmation -->
  <div id="close-account-modal" class="vt-dialog-overlay" role="alertdialog" aria-modal="true" aria-labelledby="close-account-title" aria-describedby="close-account-desc">
    <div class="vt-dialog">
      <div class="vt-dialog-header">
        <div class="vt-icon-badge vt-dialog-icon vt-dialog-icon-danger"><TriangleAlert /></div>
        <div class="vt-dialog-heading">
          <h3 id="close-account-title" class="vt-dialog-title">Close this account?</h3>
          <p id="close-account-desc" class="vt-dialog-description">This permanently closes Florin and exports your data. This can't be undone.</p>
        </div>
      </div>
      <div class="vt-dialog-footer">
        <button type="button" class="vt-btn vt-btn-ghost" data-modal-close>Cancel</button>
        <button type="button" class="vt-btn vt-btn-danger" data-modal-close><Trash2 class="vt-w-4 vt-h-4" /> Close account</button>
      </div>
    </div>
  </div>
</FlorinShell>
