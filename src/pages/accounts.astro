---
import { url } from '../lib/url';
// Florin — Accounts & Cards. Account cards, detail, and card visuals.
import FlorinShell from '../components/FlorinShell.astro';
import FlorinModals from '../components/FlorinModals.astro';
import FlorinCard from '../components/FlorinCard.astro';
import {
  Plus, Wallet, Landmark, PiggyBank, Copy, ArrowLeftRight, Send, Snowflake,
  Settings, ArrowDownLeft, ArrowUpRight, ChevronDown,
} from '@lucide/astro';

// Three USD accounts that sum to the $128,540.00 total shown across the app.
const accounts = [
  { name: 'Main · USD',   balance: '$84,140.00', kind: 'Business checking', icon: Wallet,    brand: true },
  { name: 'Savings',      balance: '$31,500.00', kind: '3.10% APY',          icon: PiggyBank, brand: false },
  { name: 'Tax reserve',  balance: '$12,900.00', kind: 'Set aside monthly',  icon: Landmark,  brand: false },
];

const activity = [
  { name: 'Stripe Payout',    date: 'Jul 21', amount: '+$12,480.00', pos: true },
  { name: 'AWS',              date: 'Jul 20', amount: '−$2,314.90',  pos: false },
  { name: 'Contractor · Lee', date: 'Jul 19', amount: '−$4,200.00',  pos: false },
  { name: 'Client · Aster',   date: 'Jul 15', amount: '+$5,400.00',  pos: true },
];

// Add-account modal: options of the Currency Select ([data-select], driven by FlorinShell).
const currencies = ['USD — US Dollar', 'EUR — Euro', 'GBP — British Pound'];
---

<FlorinShell active="accounts" title="Florin — Accounts" description="Florin accounts & cards — balances, IBANs, card controls. Built with Veritheme.">
  <!-- Title + actions -->
  <div class="vt-flex vt-items-center vt-justify-between vt-gap-4">
    <div>
      <h1 class="vt-heading-md">Accounts</h1>
      <p class="vt-body-sm vt-text-foreground-muted vt-mt-1">3 accounts · $128,540.00 total balance</p>
    </div>
    <button type="button" class="vt-btn vt-btn-primary" data-modal-open="add-account-modal"><Plus class="vt-w-4 vt-h-4" /> Add account</button>
  </div>

  <!-- Account tiles (Stats Card; the main account's icon carries the brand tone) -->
  <div class="vt-grid vt-grid-cols-1 vt-sm:grid-cols-3 vt-gap-4">
    {accounts.map((a) => (
      <div class="vt-card vt-stats-card">
        <div class="vt-stats-card-header">
          <div class="vt-stats-card-content">
            <p class="vt-stats-card-label">{a.name}</p>
            <p class="vt-stats-card-value">{a.balance}</p>
          </div>
          <div class:list={['vt-icon-badge vt-icon-badge-square', { 'fl-tone-brand': a.brand }]}><a.icon class="vt-icon-badge-icon" /></div>
        </div>
        <p class="vt-stats-card-note">{a.kind}</p>
      </div>
    ))}
  </div>

  <!-- Detail: card visual + IBAN/actions, and recent activity -->
  <div class="vt-grid vt-grid-cols-1 vt-lg:grid-cols-3 vt-gap-6">
    <!-- Physical/virtual card -->
    <div class="vt-card">
      <div class="vt-card-body">
        <h2 class="vt-label-md">Your card</h2>
        <FlorinCard data-account-card class="vt-mt-4 vt-transition-opacity" brand name="Business" kind="Physical" last="4921" exp="08/28" holder="Sofia Marchetti" net="VISA" />
        <div class="vt-grid vt-grid-cols-2 vt-gap-2 vt-mt-4">
          <button type="button" class="vt-btn vt-btn-bordered vt-btn-sm" data-freeze-toggle aria-pressed="false"><Snowflake class="vt-w-4 vt-h-4" /> Freeze</button>
          <a href={url('/cards')} class="vt-btn vt-btn-bordered vt-btn-sm"><Settings class="vt-w-4 vt-h-4" /> Manage</a>
        </div>
      </div>
    </div>

    <!-- Account detail + activity -->
    <div class="vt-lg:col-span-2 vt-card">
      <div class="vt-card-header vt-flex vt-items-center vt-justify-between vt-gap-4">
        <div>
          <h2 class="vt-label-md">Main · USD</h2>
          <p class="vt-caption vt-text-foreground-muted vt-mt-0.5">Business checking · $84,140.00</p>
        </div>
        <div class="vt-flex vt-items-center vt-gap-2">
          <button type="button" class="vt-btn vt-btn-bordered vt-btn-sm" data-modal-open="send-modal"><Send class="vt-w-4 vt-h-4" /> Send</button>
          <button type="button" class="vt-btn vt-btn-bordered vt-btn-sm" data-modal-open="move-modal"><ArrowLeftRight class="vt-w-4 vt-h-4" /> Move</button>
        </div>
      </div>
      <div class="vt-card-body vt-space-y-4">
        <!-- IBAN / routing -->
        <div class="vt-grid vt-grid-cols-1 vt-sm:grid-cols-2 vt-gap-4">
          <div class="vt-rounded-xl vt-border vt-border-border-default vt-p-4">
            <p class="vt-caption vt-text-foreground-muted">Account number</p>
            <div class="vt-flex vt-items-center vt-justify-between vt-gap-2 vt-mt-1">
              <span class="vt-label-md">•••• 4921 0038</span>
              <button type="button" class="vt-btn vt-btn-ghost vt-btn-sm" aria-label="Copy account number" data-copy="4921 0038"><Copy class="vt-w-4 vt-h-4" /></button>
            </div>
          </div>
          <div class="vt-rounded-xl vt-border vt-border-border-default vt-p-4">
            <p class="vt-caption vt-text-foreground-muted">Routing</p>
            <div class="vt-flex vt-items-center vt-justify-between vt-gap-2 vt-mt-1">
              <span class="vt-label-md">021 000 021</span>
              <button type="button" class="vt-btn vt-btn-ghost vt-btn-sm" aria-label="Copy routing number" data-copy="021000021"><Copy class="vt-w-4 vt-h-4" /></button>
            </div>
          </div>
        </div>

        <!-- Recent activity -->
        <div>
          <p class="vt-section-label vt-py-2">Recent activity</p>
          <div class="vt-divide-y vt-divide-border-default">
            {activity.map((t) => (
              <div class="vt-flex vt-items-center vt-justify-between vt-gap-3 vt-py-3">
                <div class="vt-flex vt-items-center vt-gap-3 vt-min-w-0">
                  <div class:list={['vt-icon-badge vt-icon-badge-sm', { 'fl-tone-success': t.pos }]}>
                    {t.pos ? <ArrowDownLeft class="vt-icon-badge-icon" /> : <ArrowUpRight class="vt-icon-badge-icon" />}
                  </div>
                  <p class="vt-label-md vt-truncate">{t.name}</p>
                </div>
                <div class="vt-flex vt-items-center vt-gap-4 vt-flex-shrink-0">
                  <span class="vt-caption vt-text-foreground-muted">{t.date}</span>
                  <span class:list={['vt-label-md vt-whitespace-nowrap', { 'fl-text-success': t.pos }]}>{t.amount}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Add-account modal -->
  <div id="add-account-modal" class="vt-dialog-overlay" role="dialog" aria-modal="true" aria-labelledby="add-account-title" aria-describedby="add-account-desc">
    <div class="vt-dialog vt-overflow-visible">
      <div class="vt-dialog-header">
        <div class="vt-dialog-heading">
          <h3 id="add-account-title" class="vt-dialog-title">Add an account</h3>
          <p id="add-account-desc" class="vt-dialog-description">Open a new account in seconds — no paperwork.</p>
        </div>
      </div>
      <div class="vt-dialog-body">
        <div class="vt-field">
          <label class="vt-label" for="acct-name">Account name</label>
          <input id="acct-name" class="vt-input" type="text" placeholder="e.g. Payroll" />
        </div>
        <div class="vt-field">
          <label class="vt-label" for="acct-currency">Currency</label>
          <div class="vt-relative" data-select>
            <button type="button" id="acct-currency" class="vt-select-trigger" aria-haspopup="listbox">
              <span data-select-label>{currencies[0]}</span>
              <ChevronDown aria-hidden="true" />
            </button>
            <div class="vt-select-dropdown" role="listbox" aria-label="Currency">
              {currencies.map((c, i) => (
                <div class="vt-select-item" role="option" aria-selected={i === 0 ? 'true' : undefined}>{c}</div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div class="vt-dialog-footer">
        <button type="button" class="vt-btn vt-btn-ghost" data-modal-close>Cancel</button>
        <button type="button" class="vt-btn vt-btn-primary" data-modal-close><Plus class="vt-w-4 vt-h-4" /> Create account</button>
      </div>
    </div>
  </div>

  <FlorinModals />

  <script is:inline>
    (function () {
      // Freeze dims the card; the button shows the state.
      var btn = document.querySelector('[data-freeze-toggle]');
      var card = document.querySelector('[data-account-card]');
      if (btn) {
        var frozen = false;
        btn.addEventListener('click', function () {
          frozen = !frozen;
          btn.lastChild.textContent = frozen ? ' Frozen' : ' Freeze';
          btn.setAttribute('aria-pressed', frozen ? 'true' : 'false');
          if (card) card.classList.toggle('vt-opacity-50', frozen);
        });
      }
      // Copy buttons put the number on the clipboard.
      document.querySelectorAll('[data-copy]').forEach(function (b) {
        var label = b.getAttribute('aria-label');
        b.addEventListener('click', function () {
          if (navigator.clipboard) navigator.clipboard.writeText(b.getAttribute('data-copy'));
          b.setAttribute('aria-label', 'Copied');
          setTimeout(function () { b.setAttribute('aria-label', label); }, 1500);
        });
      });
    })();
  </script>
</FlorinShell>
