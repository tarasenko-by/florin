---
// Florin — Analytics. KPI row, cashflow chart, spend channels, top merchants.
import FlorinShell from '../components/FlorinShell.astro';
import { Download, Building2, CreditCard, Landmark, Receipt, Send } from '@lucide/astro';

const periods = ['7D', '30D', '12M'];

// The business is net-positive, so "runway/burn" framing is wrong — show margin.
const kpis = [
  { label: 'Net income',    value: '$33,360',  trend: '+18.2%', up: true, spark: [22, 26, 24, 30, 28, 36, 40] },
  { label: 'Monthly spend', value: '$18,940',  trend: '−5.2%',  up: true, spark: [34, 30, 32, 28, 26, 24, 22] },
  { label: 'Net margin',    value: '64%',      trend: '+4 pts', up: true, spark: [48, 52, 50, 55, 58, 60, 64] },
  { label: 'Avg. balance',  value: '$121,300', trend: '+3.9%',  up: true, spark: [90, 96, 100, 108, 112, 116, 121] },
];

const chart = [
  { m: 'Aug', inc: 'vt-h-20', exp: 'vt-h-12' }, { m: 'Sep', inc: 'vt-h-24', exp: 'vt-h-14' },
  { m: 'Oct', inc: 'vt-h-16', exp: 'vt-h-16' }, { m: 'Nov', inc: 'vt-h-28', exp: 'vt-h-12' },
  { m: 'Dec', inc: 'vt-h-32', exp: 'vt-h-20' }, { m: 'Jan', inc: 'vt-h-24', exp: 'vt-h-14' },
  { m: 'Feb', inc: 'vt-h-28', exp: 'vt-h-16' }, { m: 'Mar', inc: 'vt-h-32', exp: 'vt-h-16' },
  { m: 'Apr', inc: 'vt-h-24', exp: 'vt-h-24' }, { m: 'May', inc: 'vt-h-32', exp: 'vt-h-14' },
  { m: 'Jun', inc: 'vt-h-40', exp: 'vt-h-20' }, { m: 'Jul', inc: 'vt-h-40', exp: 'vt-h-16' },
];

// Shares sum to 100%.
const channels = [
  { icon: Building2,  label: 'Payroll & contractors', pct: '45%', w: 'vt-w-4/5' },
  { icon: CreditCard, label: 'Software & SaaS',        pct: '17%', w: 'vt-w-2/5' },
  { icon: Landmark,   label: 'Office & rent',          pct: '15%', w: 'vt-w-1/3' },
  { icon: Receipt,    label: 'Travel & meals',         pct: '13%', w: 'vt-w-1/4' },
  { icon: Send,       label: 'Fees & other',           pct: '10%', w: 'vt-w-1/6' },
];

const merchants = [
  { name: 'Ramp Payroll', cat: 'Payroll',  txns: '18', amount: '$8,420.00' },
  { name: 'AWS',          cat: 'Software',  txns: '6',  amount: '$3,110.00' },
  { name: 'WeWork',       cat: 'Office',    txns: '1',  amount: '$2,600.00' },
  { name: 'Delta',        cat: 'Travel',    txns: '4',  amount: '$1,540.00' },
  { name: 'Figma',        cat: 'Software',  txns: '2',  amount: '$288.00' },
];

// Catmull-Rom → cubic-bezier smoothing, shared by the area chart and sparklines.
function smooth(pts) {
  if (pts.length < 2) return '';
  let d = `M ${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2;
    const c1x = p1[0] + (p2[0] - p0[0]) / 6, c1y = p1[1] + (p2[1] - p0[1]) / 6;
    const c2x = p2[0] - (p3[0] - p1[0]) / 6, c2y = p2[1] - (p3[1] - p1[1]) / 6;
    d += ` C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }
  return d;
}
function sparkPath(vals) {
  const w = 100, h = 32, p = 3, mx = Math.max(...vals), mn = Math.min(...vals);
  const px = (i) => p + (i * (w - 2 * p)) / (vals.length - 1);
  const py = (v) => h - p - ((v - mn) / (mx - mn || 1)) * (h - 2 * p);
  return smooth(vals.map((v, i) => [px(i), py(v)]));
}

// ── Cash balance — smoothed area chart (12-month trend, $k) ──
const balance = [82, 86, 89, 95, 101, 98, 107, 114, 111, 120, 127, 133];
const balMonths = ['Aug', 'Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'];
const AW = 720, AH = 200, AP = 10;
const N = balance.length, SLOT = AW / N;
const bMax = Math.max(...balance), bMin = Math.min(...balance);
// Points sit at slot centres so they line up with the flex-1 month labels below.
const ax = (i) => SLOT * (i + 0.5);
const ay = (v) => AH - AP - ((v - bMin) / (bMax - bMin || 1)) * (AH - 2 * AP - 24);
const balPts = balance.map((v, i) => [ax(i), ay(v)]);
const balLine = smooth(balPts);
const balArea = `${balLine} L ${ax(N - 1).toFixed(1)} ${AH} L ${ax(0).toFixed(1)} ${AH} Z`;
const balGrid = [0, 0.25, 0.5, 0.75, 1].map((t) => AP + t * (AH - 2 * AP));
// Dots are drawn as HTML (not inside the stretched SVG) so they stay perfectly round.
const balDots = balance.map((v, i) => ({
  left: (ax(i) / AW) * 100,
  top: (ay(v) / AH) * 100,
  tip: `${balMonths[i]} · $${(v * 1000).toLocaleString('en-US')}`,
}));

// ── Spending mix — donut (stroke-dasharray segments) ─────────
// Monochrome brand ramp — reads cleanly and re-themes as one hue.
const mix = [
  { label: 'Payroll',  pct: 45, op: 1 },
  { label: 'Software', pct: 17, op: 0.66 },
  { label: 'Office',   pct: 15, op: 0.44 },
  { label: 'Travel',   pct: 13, op: 0.28 },
  { label: 'Other',    pct: 10, op: 0.15 },
];
const DR = 54, CIRC = 2 * Math.PI * DR;
const mixTotal = 18940;
let mAcc = 0;
const donut = mix.map((s) => {
  const seg = {
    ...s,
    dash: (s.pct / 100) * CIRC,
    offset: -(mAcc / 100) * CIRC,
    tip: `${s.label} · $${Math.round((mixTotal * s.pct) / 100).toLocaleString('en-US')} (${s.pct}%)`,
  };
  mAcc += s.pct;
  return seg;
});
---

<FlorinShell active="analytics" title="Florin — Analytics" description="Florin analytics — net income, burn, runway, spend channels. Built with Veritheme.">
  <!-- Title + period -->
  <div class="vt-flex vt-items-center vt-justify-between vt-gap-4">
    <div>
      <h1 class="vt-text-2xl vt-font-bold">Analytics</h1>
      <p class="vt-text-sm vt-text-mains-quaternary vt-mt-1">Cash performance · last 12 months</p>
    </div>
    <button class="vt-btn vt-btn-bordered"><Download class="vt-w-4 vt-h-4" /> Export</button>
  </div>

  <!-- KPIs -->
  <div class="vt-grid vt-grid-cols-2 vt-lg:grid-cols-4 vt-gap-4">
    {kpis.map((k) => (
      <div class="vt-card vt-p-5">
        <p class="vt-text-sm vt-text-mains-quaternary">{k.label}</p>
        <p class="vt-text-2xl vt-font-bold vt-mt-1">{k.value}</p>
        <div class="vt-flex vt-items-end vt-justify-between vt-gap-3 vt-mt-1">
          <span class={`vt-text-xs vt-font-medium ${k.up ? 'vt-text-success-primary' : 'vt-text-error-primary'}`}>{k.trend}</span>
          <svg viewBox="0 0 100 32" height="26" class="vt-w-20 vt-flex-shrink-0 vt-cursor-pointer" preserveAspectRatio="none" data-tip={`${k.label}: ${k.trend} · last 7 mo`}>
            <path d={sparkPath(k.spark)} fill="none" stroke={k.up ? 'hsl(var(--success-primary))' : 'hsl(var(--error-primary))'} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          </svg>
        </div>
      </div>
    ))}
  </div>

  <!-- Cash balance (area) + Spending mix (donut) -->
  <div class="vt-grid vt-grid-cols-1 vt-lg:grid-cols-3 vt-gap-6">
    <!-- Area chart -->
    <div class="vt-lg:col-span-2 vt-card vt-p-6">
      <div class="vt-flex vt-items-start vt-justify-between vt-gap-4">
        <div>
          <h2 class="vt-text-sm vt-font-semibold">Cash balance</h2>
          <p class="vt-text-xs vt-text-mains-quaternary vt-mt-0.5">12 months · $133,000 today</p>
        </div>
        <span class="vt-badge vt-badge-soft vt-badge-success">+62% YoY</span>
      </div>
      <div class="vt-relative vt-mt-5" data-area-chart>
        <svg viewBox={`0 0 ${AW} ${AH}`} class="vt-w-full vt-h-48 vt-block" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="balArea" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="hsl(var(--success-primary))" stop-opacity="0.16" />
              <stop offset="100%" stop-color="hsl(var(--success-primary))" stop-opacity="0" />
            </linearGradient>
          </defs>
          {balGrid.map((y) => (
            <line x1="0" x2={AW} y1={y} y2={y} stroke="hsl(var(--border-default))" stroke-width="1" vector-effect="non-scaling-stroke" />
          ))}
          <path d={balArea} fill="url(#balArea)" />
          <path d={balLine} fill="none" stroke="hsl(var(--success-primary))" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
        </svg>
        <!-- Round dots as HTML — immune to the non-uniform SVG stretch -->
        {balDots.map((d, i) => (
          <span
            class="vt-absolute vt-w-3 vt-h-3 vt-rounded-full vt-bg-surfaces-surface vt-border-2 vt-border-success-primary vt-transition-transform"
            style={`left:${d.left.toFixed(2)}%;top:${d.top.toFixed(2)}%;transform:translate(-50%,-50%)`}
            data-dot={i}
          ></span>
        ))}
        <!-- Full-height hover columns → tooltip per month (aligned to slot centres) -->
        <div class="vt-absolute vt-inset-0 vt-flex" data-area-cols>
          {balDots.map((d) => (
            <div class="vt-flex-1 vt-h-full" data-tip={d.tip}></div>
          ))}
        </div>
      </div>
      <div class="vt-flex vt-mt-2">
        {balMonths.map((m) => (
          <span class="vt-flex-1 vt-text-center vt-text-xs vt-text-mains-quaternary">{m}</span>
        ))}
      </div>
    </div>

    <!-- Donut -->
    <div class="vt-card vt-p-6">
      <h2 class="vt-text-sm vt-font-semibold">Spending mix</h2>
      <p class="vt-text-xs vt-text-mains-quaternary vt-mt-0.5">This month · $18,940</p>
      <div class="vt-relative vt-flex vt-justify-center vt-mt-4">
        <svg width="152" height="152" viewBox="0 0 120 120" role="img" aria-label="Spending mix by category">
          <g transform="rotate(-90 60 60)">
            <circle cx="60" cy="60" r={DR} fill="none" stroke="hsl(var(--surfaces-subtle))" stroke-width="12" />
            {donut.map((s) => (
              <circle
                cx="60" cy="60" r={DR} fill="none"
                stroke={`hsl(var(--accents-brand) / ${s.op})`} stroke-width="12"
                stroke-dasharray={`${s.dash.toFixed(2)} ${(CIRC - s.dash).toFixed(2)}`}
                stroke-dashoffset={s.offset.toFixed(2)}
                class="vt-cursor-pointer" data-tip={s.tip}
              />
            ))}
          </g>
        </svg>
        <div class="vt-absolute vt-inset-0 vt-flex vt-flex-col vt-items-center vt-justify-center">
          <span class="vt-text-2xl vt-font-bold">$18.9k</span>
          <span class="vt-text-xs vt-text-mains-quaternary">total spend</span>
        </div>
      </div>
      <div class="vt-space-y-2 vt-mt-5">
        {mix.map((s) => (
          <div class="vt-flex vt-items-center vt-justify-between vt-gap-2 vt-text-sm">
            <span class="vt-flex vt-items-center vt-gap-2 vt-min-w-0">
              <span class="vt-w-2 vt-h-2 vt-rounded-sm vt-flex-shrink-0" style={`background: hsl(var(--accents-brand) / ${s.op})`}></span>
              <span class="vt-truncate">{s.label}</span>
            </span>
            <span class="vt-text-mains-quaternary vt-whitespace-nowrap">{s.pct}%</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Chart -->
  <div class="vt-card vt-p-6">
    <div class="vt-flex vt-items-start vt-justify-between vt-gap-4">
      <div>
        <h2 class="vt-text-sm vt-font-semibold">Income vs spending</h2>
        <p class="vt-text-xs vt-text-mains-quaternary vt-mt-0.5">$33,360 avg. net flow</p>
      </div>
      <div class="vt-flex vt-items-center vt-gap-4">
        <span class="vt-flex vt-items-center vt-gap-1.5 vt-text-xs vt-text-mains-secondary vt-hidden vt-sm:flex"><span class="vt-w-2 vt-h-2 vt-rounded-sm vt-bg-accents-brand"></span> Income</span>
        <span class="vt-flex vt-items-center vt-gap-1.5 vt-text-xs vt-text-mains-secondary vt-hidden vt-sm:flex"><span class="vt-w-2 vt-h-2 vt-rounded-sm vt-bg-surfaces-contrast"></span> Spending</span>
        <div class="vt-btn-group">
          {periods.map((p, i) => (
            <button class={i === 2 ? 'vt-active' : undefined} data-period={p.toLowerCase()}>{p}</button>
          ))}
        </div>
      </div>
    </div>
    <div data-chart-bars class="vt-flex vt-items-end vt-gap-3 vt-h-48 vt-mt-6">
      {chart.map((c) => (
        <div class="vt-flex-1 vt-flex vt-items-end vt-justify-center vt-gap-1.5">
          <div class={`vt-flex-1 vt-rounded-t vt-bg-accents-brand ${c.inc}`} style="max-width:1.75rem"></div>
          <div class={`vt-flex-1 vt-rounded-t vt-bg-surfaces-contrast ${c.exp}`} style="max-width:1.75rem"></div>
        </div>
      ))}
    </div>
    <div data-chart-labels class="vt-flex vt-gap-2 vt-mt-2">
      {chart.map((c) => (
        <span class="vt-flex-1 vt-text-center vt-text-xs vt-text-mains-quaternary">{c.m}</span>
      ))}
    </div>
  </div>

  <!-- Channels + top merchants -->
  <div class="vt-grid vt-grid-cols-1 vt-lg:grid-cols-3 vt-gap-6">
    <div class="vt-card vt-p-6">
      <h2 class="vt-text-sm vt-font-semibold">Spending by channel</h2>
      <p class="vt-text-xs vt-text-mains-quaternary vt-mt-0.5">Share of $18,940</p>
      <div class="vt-space-y-4 vt-mt-5">
        {channels.map((c) => (
          <div>
            <div class="vt-flex vt-items-center vt-justify-between vt-gap-2">
              <div class="vt-flex vt-items-center vt-gap-2 vt-min-w-0">
                <div class="vt-icon-badge vt-icon-badge-sm"><c.icon class="vt-w-4 vt-h-4" /></div>
                <p class="vt-text-sm vt-font-medium vt-truncate">{c.label}</p>
              </div>
              <span class="vt-text-xs vt-text-mains-quaternary vt-whitespace-nowrap">{c.pct}</span>
            </div>
            <div class="vt-progress vt-progress-sm vt-mt-2"><div class={`vt-progress-bar ${c.w}`}></div></div>
          </div>
        ))}
      </div>
    </div>

    <div class="vt-lg:col-span-2 vt-card">
      <div class="vt-card-header vt-flex vt-items-center vt-justify-between vt-gap-4">
        <h2 class="vt-text-sm vt-font-semibold">Top merchants</h2>
        <a href="/transactions" class="vt-link">View all</a>
      </div>
      <div class="vt-overflow-x-auto">
        <table class="vt-w-full vt-border-collapse vt-text-sm">
          <thead>
            <tr class="vt-text-left vt-text-xs vt-text-mains-quaternary vt-bg-surfaces-subtle">
              <th class="vt-font-medium vt-px-6 vt-py-3">Merchant</th>
              <th class="vt-font-medium vt-px-6 vt-py-3 vt-hidden vt-sm:table-cell">Category</th>
              <th class="vt-font-medium vt-px-6 vt-py-3 vt-text-right">Txns</th>
              <th class="vt-font-medium vt-px-6 vt-py-3 vt-text-right">Total</th>
            </tr>
          </thead>
          <tbody>
            {merchants.map((m) => (
              <tr class="vt-border-t vt-border-border-default">
                <td class="vt-px-6 vt-py-3 vt-font-medium">{m.name}</td>
                <td class="vt-px-6 vt-py-3 vt-text-mains-secondary vt-hidden vt-sm:table-cell">{m.cat}</td>
                <td class="vt-px-6 vt-py-3 vt-text-right vt-text-mains-secondary">{m.txns}</td>
                <td class="vt-px-6 vt-py-3 vt-text-right vt-font-medium vt-whitespace-nowrap">{m.amount}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      // [month/label, income px, expense px] per period. Bars grow-animate on switch.
      var DATA = {
        '7d': [['Mon',70,44],['Tue',96,52],['Wed',60,64],['Thu',120,40],['Fri',150,58],['Sat',84,36],['Sun',110,48]],
        '30d': [['W1',110,72],['W2',150,64],['W3',96,88],['W4',176,70]],
        '12m': [['Aug',80,48],['Sep',96,56],['Oct',64,64],['Nov',112,48],['Dec',128,80],['Jan',96,56],['Feb',112,64],['Mar',128,64],['Apr',96,96],['May',128,56],['Jun',160,80],['Jul',160,64]],
      };
      var bars = document.querySelector('[data-chart-bars]');
      var labels = document.querySelector('[data-chart-labels]');
      var ease = 'height 0.45s cubic-bezier(0.16,1,0.3,1)';
      function render(period) {
        var rows = DATA[period]; if (!rows || !bars) return;
        bars.innerHTML = ''; labels.innerHTML = '';
        var cols = rows.map(function (r) {
          var col = document.createElement('div');
          col.className = 'vt-flex-1 vt-flex vt-items-end vt-justify-center vt-gap-1.5';
          var inc = document.createElement('div');
          inc.className = 'vt-flex-1 vt-rounded-t vt-bg-accents-brand';
          inc.style.height = '0px'; inc.style.maxWidth = '1.75rem'; inc.style.transition = ease; inc.style.cursor = 'pointer';
          inc.setAttribute('data-tip', r[0] + ' · Income $' + (r[1] * 400).toLocaleString());
          var exp = document.createElement('div');
          exp.className = 'vt-flex-1 vt-rounded-t vt-bg-surfaces-contrast';
          exp.style.height = '0px'; exp.style.maxWidth = '1.75rem'; exp.style.transition = ease; exp.style.cursor = 'pointer';
          exp.setAttribute('data-tip', r[0] + ' · Spending $' + (r[2] * 400).toLocaleString());
          col.appendChild(inc); col.appendChild(exp); bars.appendChild(col);
          var lbl = document.createElement('span');
          lbl.className = 'vt-flex-1 vt-text-center vt-text-xs vt-text-mains-quaternary';
          lbl.textContent = r[0]; labels.appendChild(lbl);
          return [inc, exp, r[1], r[2]];
        });
        requestAnimationFrame(function () { requestAnimationFrame(function () {
          cols.forEach(function (c) { c[0].style.height = c[2] + 'px'; c[1].style.height = c[3] + 'px'; });
        }); });
      }
      document.querySelectorAll('[data-period]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          document.querySelectorAll('[data-period]').forEach(function (b) { b.classList.remove('vt-active'); });
          btn.classList.add('vt-active');
          render(btn.getAttribute('data-period'));
        });
      });
      render('12m'); // take over the server-rendered bars with an animated draw-in
    })();

    // Area chart: emphasise the matching dot while hovering a month column.
    (function () {
      var cols = document.querySelectorAll('[data-area-cols] > div');
      var dots = document.querySelectorAll('[data-dot]');
      cols.forEach(function (col, i) {
        var dot = dots[i]; if (!dot) return;
        col.addEventListener('mouseenter', function () { dot.style.transform = 'translate(-50%,-50%) scale(1.7)'; });
        col.addEventListener('mouseleave', function () { dot.style.transform = 'translate(-50%,-50%) scale(1)'; });
      });
    })();
  </script>
</FlorinShell>
