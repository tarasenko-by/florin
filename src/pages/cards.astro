---
import { url } from '../lib/url';
// Florin — Cards. Selectable card wallet: pick a card on the right, see it
// large with its spend + controls on the left. Realistic card visuals that
// re-skin with the theme.
import FlorinShell from '../components/FlorinShell.astro';
import FlorinModals from '../components/FlorinModals.astro';
import FlorinCard from '../components/FlorinCard.astro';
import { Plus, Snowflake, Globe, Landmark, ArrowUpRight, ChevronDown } from '@lucide/astro';

const cards = [
  { id: 'physical', name: 'Business', kind: 'Physical', last: '4921', exp: '08/28',
    holder: 'Sofia Marchetti', brand: true,  net: 'VISA', spent: 8240, limit: 15000 },
  { id: 'virtual',  name: 'Team',     kind: 'Virtual',  last: '7730', exp: '03/27',
    holder: 'Sofia Marchetti', brand: false, net: 'MC',   spent: 3110, limit: 5000 },
];

const controls = [
  { key: 'freeze', icon: Snowflake, title: 'Freeze card',    desc: 'Instantly block all transactions.', on: false },
  { key: 'online', icon: Globe,     title: 'Online payments', desc: 'E-commerce and subscriptions.',     on: true },
  { key: 'atm',    icon: Landmark,  title: 'ATM withdrawals', desc: 'Allow cash withdrawals.',           on: true },
];

const activity = [
  { name: 'AWS',    cat: 'Cloud',    date: 'Jul 20', amount: '−$2,314.90' },
  { name: 'Figma',  cat: 'Software', date: 'Jul 20', amount: '−$144.00' },
  { name: 'WeWork', cat: 'Office',   date: 'Jul 17', amount: '−$2,600.00' },
];

// New-card modal: options of the Type Select ([data-select], driven by FlorinShell).
const cardTypes = ['Virtual — instant', 'Physical — ships in 5 days'];

const money = (n: number) => '$' + n.toLocaleString('en-US');
const first = cards[0];
const pct = (c: typeof cards[number]) => Math.round((c.spent / c.limit) * 100);
---

<FlorinShell active="cards" title="Florin — Cards" description="Florin cards — a selectable wallet with realistic cards, spend, and controls. Built with Veritheme.">
  <div class="vt-flex vt-items-center vt-justify-between vt-gap-4">
    <div>
      <h1 class="vt-heading-md">Cards</h1>
      <p class="vt-body-sm vt-text-foreground-muted vt-mt-1">{cards.length} active cards · issue virtual cards instantly.</p>
    </div>
    <button type="button" class="vt-btn vt-btn-primary" data-modal-open="new-card-modal"><Plus class="vt-w-4 vt-h-4" /> New card</button>
  </div>

  <div class="vt-grid vt-grid-cols-1 vt-lg:grid-cols-3 vt-gap-6 vt-items-start">
    <!-- Selected card: visual + spend + controls -->
    <div class="vt-lg:col-span-2 vt-card">
      <div class="vt-card-body vt-space-y-6">
        <div class="vt-flex vt-flex-col vt-sm:flex-row vt-gap-6">
          <!-- Realistic card visual (re-skins with the theme) -->
          <div class="vt-w-full vt-max-w-xs vt-flex-shrink-0">
            <FlorinCard id="feat-card" interactive brand={first.brand} name={first.name} kind={first.kind} last={first.last} exp={first.exp} holder={first.holder} net={first.net} />
          </div>

          <!-- Spend against the card's monthly limit. Part of the selected-card panel, not a
               KPI tile: a Stats Card's own 24px padding would inset it from the card visual. -->
          <div class="vt-flex-1 vt-min-w-0 vt-flex vt-flex-col vt-justify-center">
            <p class="vt-body-sm vt-text-foreground-muted">Spent this month</p>
            <p class="vt-heading-md vt-mt-1">
              <span id="feat-spent">{money(first.spent)}</span>
              <span class="vt-label-lg vt-text-foreground-muted">/ <span id="feat-limit">{money(first.limit)}</span></span>
            </p>
            <div class="vt-progress vt-mt-3"><div id="feat-prog" class="vt-progress-bar fl-bar" style={`--w: ${pct(first)}%`}></div></div>
            <div class="vt-flex vt-items-center vt-justify-between vt-gap-2 vt-mt-2">
              <span class="vt-body-sm vt-text-foreground-muted">Available</span>
              <span id="feat-avail" class="vt-label-md">{money(first.limit - first.spent)}</span>
            </div>
          </div>
        </div>

        <div class="vt-separator"></div>

        <!-- Controls (contextual to the selected card) -->
        <div>
          <h2 class="vt-label-md">Card controls · <span id="ctrl-last">•••• {first.last}</span></h2>
          <div class="vt-grid vt-grid-cols-1 vt-sm:grid-cols-3 vt-gap-4 vt-mt-4">
            {controls.map((ctl) => (
              <div class="vt-rounded-xl vt-border vt-border-border-default vt-p-4">
                <div class="vt-flex vt-items-center vt-justify-between vt-gap-2">
                  <div class="vt-icon-badge vt-icon-badge-sm"><ctl.icon class="vt-icon-badge-icon" /></div>
                  <button
                    type="button"
                    role="switch"
                    aria-checked={ctl.on ? 'true' : 'false'}
                    aria-label={ctl.title}
                    class:list={['vt-switch vt-flex-shrink-0', { 'vt-active': ctl.on }]}
                  ><span class="vt-switch-thumb"></span></button>
                </div>
                <p class="vt-label-md vt-mt-3">{ctl.title}</p>
                <p class="vt-caption vt-text-foreground-muted vt-mt-0.5">{ctl.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Wallet: pick a card (List of option rows; the selected one is vt-active) -->
    <div class="vt-card">
      <div class="vt-card-body">
        <h2 class="vt-label-md">Your cards</h2>
        <div class="vt-list vt-mt-4" role="listbox" aria-label="Your cards">
          {cards.map((c, i) => (
            <button
              type="button"
              role="option"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-card-select
              data-name={c.name} data-kind={c.kind} data-last={c.last} data-exp={c.exp}
              data-holder={c.holder} data-net={c.net} data-brand={c.brand ? '1' : '0'}
              data-spent={c.spent} data-limit={c.limit}
              class:list={['vt-list-item vt-w-full vt-text-left', { 'vt-active': i === 0 }]}
            >
              <FlorinCard mini brand={c.brand} />
              <span class="vt-list-item-content">
                <span class="vt-list-item-title vt-truncate">{c.name} · {c.kind}</span>
                <span class="vt-caption vt-text-foreground-muted">•••• {c.last}</span>
              </span>
              <span class="vt-badge vt-badge-soft vt-badge-success">Active</span>
            </button>
          ))}
        </div>
        <button type="button" class="vt-btn vt-btn-bordered vt-w-full vt-mt-4" data-modal-open="new-card-modal"><Plus class="vt-w-4 vt-h-4" /> Add card</button>
      </div>
    </div>
  </div>

  <!-- Recent card activity -->
  <div class="vt-card">
    <div class="vt-card-header vt-flex vt-items-center vt-justify-between vt-gap-4">
      <h2 class="vt-label-md">Recent card activity</h2>
      <a href={url('/transactions')} class="vt-link">View all</a>
    </div>
    <div class="vt-divide-y vt-divide-border-default">
      {activity.map((t) => (
        <div class="vt-flex vt-items-center vt-justify-between vt-gap-3 vt-px-6 vt-py-3">
          <div class="vt-flex vt-items-center vt-gap-3 vt-min-w-0">
            <div class="vt-icon-badge vt-icon-badge-sm"><ArrowUpRight class="vt-icon-badge-icon" /></div>
            <div class="vt-min-w-0">
              <p class="vt-label-md vt-truncate">{t.name}</p>
              <p class="vt-caption vt-text-foreground-muted">{t.cat}</p>
            </div>
          </div>
          <div class="vt-flex vt-items-center vt-gap-4 vt-flex-shrink-0">
            <span class="vt-caption vt-text-foreground-muted">{t.date}</span>
            <span class="vt-label-md vt-whitespace-nowrap">{t.amount}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- New card -->
  <div id="new-card-modal" class="vt-dialog-overlay" role="dialog" aria-modal="true" aria-labelledby="new-card-title" aria-describedby="new-card-desc">
    <div class="vt-dialog vt-overflow-visible">
      <div class="vt-dialog-header">
        <div class="vt-dialog-heading">
          <h3 id="new-card-title" class="vt-dialog-title">Issue a new card</h3>
          <p id="new-card-desc" class="vt-dialog-description">Virtual cards are ready instantly.</p>
        </div>
      </div>
      <div class="vt-dialog-body">
        <div class="vt-field">
          <label class="vt-label" for="card-label">Card name</label>
          <input id="card-label" class="vt-input" type="text" placeholder="e.g. Marketing" />
        </div>
        <div class="vt-field">
          <label class="vt-label" for="card-type">Type</label>
          <div class="vt-relative" data-select>
            <button type="button" id="card-type" class="vt-select-trigger" aria-haspopup="listbox">
              <span data-select-label>{cardTypes[0]}</span>
              <ChevronDown aria-hidden="true" />
            </button>
            <div class="vt-select-dropdown" role="listbox" aria-label="Type">
              {cardTypes.map((t, i) => (
                <div class="vt-select-item" role="option" aria-selected={i === 0 ? 'true' : undefined}>{t}</div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div class="vt-dialog-footer">
        <button type="button" class="vt-btn vt-btn-ghost" data-modal-close>Cancel</button>
        <button type="button" class="vt-btn vt-btn-primary" data-modal-close><Plus class="vt-w-4 vt-h-4" /> Create card</button>
      </div>
    </div>
  </div>

  <FlorinModals />

  <style>
    /* Progress width is data (spent ÷ limit), passed as --w so the script can update it. */
    .fl-bar { width: var(--w); }
  </style>

  <script is:inline>
    (function () {
      var money = function (n) { return '$' + Number(n).toLocaleString('en-US'); };
      var $ = function (id) { return document.getElementById(id); };
      var items = document.querySelectorAll('[data-card-select]');
      function select(btn) {
        items.forEach(function (b) {
          var on = b === btn;
          b.classList.toggle('vt-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        var d = btn.dataset;
        $('feat-name').textContent = d.name;
        $('feat-kind').textContent = d.kind;
        $('feat-net').textContent = d.net;
        $('feat-num').textContent = '•••• •••• •••• ' + d.last;
        $('feat-holder').textContent = d.holder;
        $('feat-exp').textContent = d.exp;
        // FlorinCard's skin: brand by default, graphite for the virtual card.
        $('feat-card').classList.toggle('fl-card-graphite', d.brand !== '1');
        var spent = +d.spent, limit = +d.limit;
        $('feat-spent').textContent = money(spent);
        $('feat-limit').textContent = money(limit);
        $('feat-avail').textContent = money(limit - spent);
        $('feat-prog').style.setProperty('--w', Math.round((spent / limit) * 100) + '%');
        $('ctrl-last').textContent = '•••• ' + d.last;
      }
      items.forEach(function (b) { b.addEventListener('click', function () { select(b); }); });
    })();
  </script>
</FlorinShell>
