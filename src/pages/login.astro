---
// Florin — Sign in. Split brand layout, social + email, links to sign up / reset.
import FlorinAuth from '../components/FlorinAuth.astro';
import { Check } from '@lucide/astro';
---

<FlorinAuth title="Florin — Sign in" description="Sign in to Florin — a fintech dashboard template built with Veritheme.">
  <div class="vt-mb-6">
    <h1 class="vt-text-2xl vt-font-bold">Welcome back</h1>
    <p class="vt-text-sm vt-text-mains-quaternary vt-mt-1">Sign in to your Florin account</p>
  </div>

  <button class="vt-btn vt-btn-bordered vt-w-full">
    <svg class="vt-w-4 vt-h-4" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/>
      <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
      <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/>
      <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
    </svg>
    Continue with Google
  </button>

  <div class="vt-flex vt-items-center vt-gap-3 vt-my-5">
    <div class="vt-separator vt-separator-h vt-flex-1"></div>
    <span class="vt-text-xs vt-text-mains-quaternary">or with email</span>
    <div class="vt-separator vt-separator-h vt-flex-1"></div>
  </div>

  <form class="vt-space-y-4">
    <div>
      <label class="vt-label vt-mb-1.5 vt-block" for="email">Email</label>
      <input id="email" type="email" autocomplete="email" placeholder="you@company.com" class="vt-input" />
    </div>
    <div>
      <div class="vt-flex vt-items-center vt-justify-between vt-mb-1.5">
        <label class="vt-label" for="password">Password</label>
        <a href="/forgot-password" class="vt-text-xs vt-text-accents-brand">Forgot password?</a>
      </div>
      <input id="password" type="password" autocomplete="current-password" placeholder="••••••••" class="vt-input" />
    </div>
    <label class="vt-check-label">
      <div class="vt-checkbox checked">
        <Check class="check-icon vt-w-3 vt-h-3" stroke-width={3} />
      </div>
      <span class="vt-text-sm">Remember me for 30 days</span>
    </label>
    <a href="/overview" class="vt-btn vt-btn-primary vt-w-full">Sign in</a>
  </form>

  <p class="vt-text-center vt-text-sm vt-text-mains-quaternary vt-mt-6">No account? <a href="/signup" class="vt-text-accents-brand vt-font-medium">Create one</a></p>
</FlorinAuth>
