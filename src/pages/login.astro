---
// Florin — Sign in. Auth split (FlorinAuth): social + email, links to sign up / reset.
import FlorinAuth from '../components/FlorinAuth.astro';
import { Check } from '@lucide/astro';
---

<FlorinAuth
  title="Florin — Sign in"
  description="Sign in to Florin — a fintech dashboard template built with Veritheme."
  heading="Welcome back"
  lede="Sign in to your Florin account"
>
  <div class="vt-auth-social">
    <div class="vt-auth-providers">
      <button type="button" class="vt-btn vt-btn-bordered">
        <!-- Google's brand mark keeps its own colours. -->
        <svg class="vt-w-4 vt-h-4" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Continue with Google</span>
      </button>
    </div>
    <div class="vt-auth-divider">
      <div class="vt-separator vt-separator-h"></div><span>or with email</span><div class="vt-separator vt-separator-h"></div>
    </div>
  </div>

  <form class="vt-form">
    <div class="vt-field">
      <label class="vt-label" for="email">Email</label>
      <input id="email" type="email" autocomplete="email" placeholder="you@company.com" class="vt-input" />
    </div>
    <div class="vt-field">
      <label class="vt-label" for="password">Password</label>
      <input id="password" type="password" autocomplete="current-password" placeholder="••••••••" class="vt-input" />
    </div>
    <div class="vt-auth-options">
      <label class="vt-check-label">
        <div class="vt-checkbox checked" role="checkbox" aria-checked="true" tabindex="0" aria-label="Remember me for 30 days">
          <Check class="check-icon" stroke-width={3} />
        </div>
        Remember me for 30 days
      </label>
      <a href="/forgot-password" class="vt-link">Forgot password?</a>
    </div>
    <div class="vt-form-actions vt-form-actions-block">
      <a href="/overview" class="vt-btn vt-btn-primary"><span>Sign in</span></a>
    </div>
  </form>

  <p class="vt-auth-footer">No account? <a href="/signup" class="vt-link">Create one</a></p>
</FlorinAuth>
