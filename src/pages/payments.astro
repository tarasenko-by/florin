---
// Florin — Payments. Scheduled and recurring payments.
import FlorinShell from '../components/FlorinShell.astro';
import FlorinModals from '../components/FlorinModals.astro';
import { Plus, Send, Repeat, Clock, ArrowUpRight, Building2, Zap, CreditCard } from '@lucide/astro';

const upcoming = [
  { name: 'WeWork', cat: 'Office rent', icon: Building2,   date: 'Jul 25', amount: '$2,600.00', status: 'Scheduled', tone: 'vt-badge-info' },
  { name: 'Ramp Payroll', cat: 'Contractors', icon: Send,  date: 'Jul 28', amount: '$8,420.00', status: 'Scheduled', tone: 'vt-badge-info' },
  { name: 'AWS', cat: 'Cloud', icon: Zap,                  date: 'Aug 1',  amount: '$2,314.90', status: 'Pending',   tone: 'vt-badge-warning' },
];

const recurring = [
  { name: 'Google Workspace', icon: CreditCard, cadence: 'Monthly · 14th', amount: '$210.00' },
  { name: 'Figma',            icon: CreditCard, cadence: 'Monthly · 20th', amount: '$144.00' },
  { name: 'Notion',           icon: CreditCard, cadence: 'Monthly · 16th', amount: '$96.00' },
];
---

<FlorinShell active="payments" title="Florin — Payments" description="Florin payments — scheduled and recurring. Built with Veritheme.">
  <div class="vt-flex vt-items-center vt-justify-between vt-gap-4">
    <div>
      <h1 class="vt-text-2xl vt-font-bold">Payments</h1>
      <p class="vt-text-sm vt-text-mains-quaternary vt-mt-1">$13,334.90 scheduled over the next 14 days.</p>
    </div>
    <button class="vt-btn vt-btn-primary" data-modal-open="send-modal"><Plus class="vt-w-4 vt-h-4" /> New payment</button>
  </div>

  <div class="vt-grid vt-grid-cols-1 vt-lg:grid-cols-3 vt-gap-6">
    <!-- Upcoming -->
    <div class="vt-lg:col-span-2 vt-card">
      <div class="vt-card-header vt-flex vt-items-center vt-gap-2">
        <Clock class="vt-w-4 vt-h-4 vt-text-mains-quaternary" />
        <h2 class="vt-text-sm vt-font-semibold">Upcoming</h2>
      </div>
      <div class="vt-p-2">
        {upcoming.map((p) => (
          <div class="vt-flex vt-items-center vt-justify-between vt-gap-3 vt-p-4 vt-rounded-xl">
            <div class="vt-flex vt-items-center vt-gap-3 vt-min-w-0">
              <div class="vt-icon-badge"><p.icon class="vt-w-5 vt-h-5" /></div>
              <div class="vt-min-w-0">
                <p class="vt-text-sm vt-font-medium vt-truncate">{p.name}</p>
                <p class="vt-text-xs vt-text-mains-quaternary">{p.cat} · {p.date}</p>
              </div>
            </div>
            <div class="vt-flex vt-items-center vt-gap-3 vt-flex-shrink-0">
              <span class={`vt-badge vt-badge-soft ${p.tone}`}>{p.status}</span>
              <span class="vt-text-sm vt-font-medium vt-whitespace-nowrap">{p.amount}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Recurring -->
    <div class="vt-card">
      <div class="vt-card-header vt-flex vt-items-center vt-gap-2">
        <Repeat class="vt-w-4 vt-h-4 vt-text-mains-quaternary" />
        <h2 class="vt-text-sm vt-font-semibold">Recurring</h2>
      </div>
      <div class="vt-p-2">
        {recurring.map((r) => (
          <div class="vt-flex vt-items-center vt-justify-between vt-gap-3 vt-p-4 vt-rounded-xl">
            <div class="vt-flex vt-items-center vt-gap-3 vt-min-w-0">
              <div class="vt-icon-badge vt-icon-badge-sm"><r.icon class="vt-w-4 vt-h-4" /></div>
              <div class="vt-min-w-0">
                <p class="vt-text-sm vt-font-medium vt-truncate">{r.name}</p>
                <p class="vt-text-xs vt-text-mains-quaternary">{r.cadence}</p>
              </div>
            </div>
            <span class="vt-text-sm vt-font-medium vt-whitespace-nowrap">{r.amount}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <FlorinModals />
</FlorinShell>
