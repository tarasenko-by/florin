---
import { url } from '../lib/url';
// Florin — 404. Centered branded error screen. In a standalone repo this
// becomes the root 404.astro; here it lives under /florin for the template.
import FlorinLayout from '../layouts/FlorinLayout.astro';
import { ArrowLeft, LifeBuoy } from '@lucide/astro';
---

<FlorinLayout title="Florin — Page not found" description="404 — page not found. Florin, a fintech dashboard template built with Veritheme.">
  <div class="vt-min-h-screen vt-flex vt-flex-col">
    <header class="vt-p-6">
      <a href={url('/overview')} class="vt-inline-flex vt-items-center vt-gap-2" aria-label="Florin — go to overview">
        <span class="vt-icon-badge vt-icon-badge-sm vt-icon-badge-square fl-logo-mark vt-label-sm" aria-hidden="true">F</span>
        <span class="vt-label-lg">Florin</span>
      </a>
    </header>

    <main class="vt-flex-1 vt-flex vt-flex-col vt-items-center vt-justify-center vt-text-center vt-px-6 vt-pb-24">
      <p class="fl-404" aria-hidden="true">404</p>
      <h1 class="vt-heading-md vt-mt-4">This page took an unexpected transfer.</h1>
      <p class="vt-body-sm vt-text-foreground-muted vt-mt-2 vt-max-w-md">The page you're looking for doesn't exist or was moved. Let's get you back to your money.</p>

      <div class="vt-flex vt-flex-col vt-sm:flex-row vt-items-center vt-gap-3 vt-mt-8">
        <a href={url('/overview')} class="vt-btn vt-btn-primary"><ArrowLeft class="vt-w-4 vt-h-4" /> Back to dashboard</a>
        <a href={url('/help')} class="vt-btn vt-btn-bordered"><LifeBuoy class="vt-w-4 vt-h-4" /> Visit help center</a>
      </div>
    </main>
  </div>
</FlorinLayout>

<style>
  /* The giant error code: larger than any text style (vt-display is 2rem in
     1.2.1), fluid with the viewport, filled with the theme's brand gradient. */
  .fl-404 {
    margin: 0;
    font-size: clamp(5rem, 18vw, 10rem);
    font-weight: var(--vt-font-weight-bold);
    line-height: 1;
    background: linear-gradient(140deg, hsl(var(--vt-brand-fill)), hsl(var(--vt-brand-fill) / 0.45));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
