---
// Florin — Billing. Plan, payment method, and invoices.
import FlorinShell from '../components/FlorinShell.astro';
import { Download, CreditCard, CircleCheck, Zap, TriangleAlert } from '@lucide/astro';

const plans = [
  { name: 'Starter', price: '$0', desc: '1 account, basic analytics' },
  { name: 'Business · Pro', price: '$49', desc: 'Unlimited accounts, priority support', current: true },
  { name: 'Scale', price: '$149', desc: 'SSO, dedicated manager, SLA' },
];

const invoices = [
  { id: 'INV-2048', date: 'Jul 1, 2026', amount: '$49.00', status: 'Paid', tone: 'vt-badge-success' },
  { id: 'INV-2011', date: 'Jun 1, 2026', amount: '$49.00', status: 'Paid', tone: 'vt-badge-success' },
  { id: 'INV-1975', date: 'May 1, 2026', amount: '$49.00', status: 'Paid', tone: 'vt-badge-success' },
  { id: 'INV-1940', date: 'Apr 1, 2026', amount: '$49.00', status: 'Paid', tone: 'vt-badge-success' },
];
---

<FlorinShell active="billing" title="Florin — Billing" description="Florin billing — plan, payment method, and invoices. Built with Veritheme.">
  <div class="vt-flex vt-items-center vt-justify-between vt-gap-4">
    <div>
      <h1 class="vt-heading-md">Billing</h1>
      <p class="vt-body-sm vt-text-foreground-muted vt-mt-1">Manage your plan, payment method, and invoices.</p>
    </div>
    <button type="button" class="vt-btn vt-btn-bordered"><Download class="vt-w-4 vt-h-4" /> Download all</button>
  </div>

  <!-- Plan + payment method -->
  <div class="fl-split">
    <div class="fl-span-2 vt-card">
      <div class="vt-card-body">
        <div class="vt-flex vt-items-start vt-justify-between vt-gap-4">
          <div class="vt-flex vt-items-center vt-gap-3">
            <div class="vt-icon-badge fl-tone-brand"><Zap class="vt-w-5 vt-h-5" /></div>
            <div>
              <h2 class="vt-label-md">Business · Pro</h2>
              <p class="vt-caption vt-text-foreground-muted vt-mt-0.5">Renews Aug 1, 2026</p>
            </div>
          </div>
          <span class="vt-badge vt-badge-soft vt-badge-success">Active</span>
        </div>
        <div class="vt-flex vt-items-end vt-gap-1 vt-mt-5">
          <span class="vt-display">$49</span>
          <span class="vt-body-sm vt-text-foreground-muted vt-mb-1">/ month</span>
        </div>
        <div class="vt-grid vt-grid-cols-1 vt-sm:grid-cols-3 vt-gap-3 vt-mt-5">
          {['Unlimited accounts', 'Priority support', 'Advanced analytics'].map((f) => (
            <div class="vt-flex vt-items-center vt-gap-2">
              <CircleCheck class="vt-w-4 vt-h-4 fl-text-success" /> {f}
            </div>
          ))}
        </div>
        <div class="vt-flex vt-items-center vt-gap-2 vt-mt-6">
          <button type="button" class="vt-btn vt-btn-bordered vt-btn-sm" data-modal-open="change-plan-modal">Change plan</button>
          <button type="button" class="vt-btn vt-btn-ghost vt-btn-sm fl-text-error" data-modal-open="cancel-sub-modal">Cancel subscription</button>
        </div>
      </div>
    </div>

    <div class="vt-card">
      <div class="vt-card-body">
        <h2 class="vt-label-md">Payment method</h2>
        <div class="vt-rounded-xl vt-border vt-border-border-default vt-p-4 vt-flex vt-items-center vt-gap-3 vt-mt-4">
          <div class="vt-icon-badge"><CreditCard class="vt-w-5 vt-h-5" /></div>
          <div class="vt-min-w-0">
            <p class="vt-label-md">Visa •••• 4242</p>
            <p class="vt-caption vt-text-foreground-muted">Expires 08/28</p>
          </div>
        </div>
        <button type="button" class="vt-btn vt-btn-bordered vt-btn-sm vt-w-full vt-mt-4" data-modal-open="update-card-modal">Update card</button>
      </div>
    </div>
  </div>

  <!-- Invoices: Table inside the card that titles it -->
  <div class="vt-card">
    <div class="vt-card-header">
      <h2 class="vt-label-md">Invoices</h2>
    </div>
    <div class="vt-overflow-x-auto">
      <table class="vt-table">
        <thead>
          <tr>
            <th scope="col">Invoice</th>
            <th scope="col" class="vt-hidden vt-md:table-cell">Date</th>
            <th scope="col">Status</th>
            <th scope="col" class="vt-table-numeric">Amount</th>
            <th scope="col" class="vt-table-end"><span class="vt-sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          {invoices.map((inv) => (
            <tr>
              <td class="vt-table-strong">{inv.id}</td>
              <td class="vt-table-muted vt-hidden vt-md:table-cell">{inv.date}</td>
              <td><span class={`vt-badge vt-badge-soft ${inv.tone}`}>{inv.status}</span></td>
              <td class="vt-table-numeric vt-table-strong">{inv.amount}</td>
              <td>
                <div class="vt-table-actions">
                  <button type="button" class="vt-btn vt-btn-ghost vt-btn-sm vt-btn-icon" aria-label={`Download ${inv.id}`}><Download class="vt-w-4 vt-h-4" /></button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Change plan -->
  <div id="change-plan-modal" class="vt-dialog-overlay" role="dialog" aria-modal="true" aria-labelledby="change-plan-title">
    <div class="vt-dialog">
      <div class="vt-dialog-header">
        <div class="vt-dialog-heading">
          <h3 id="change-plan-title" class="vt-dialog-title">Change plan</h3>
          <p class="vt-dialog-description">Upgrade or downgrade anytime — prorated automatically.</p>
        </div>
      </div>
      <div class="vt-dialog-body">
        <div class="vt-space-y-2" role="radiogroup" aria-label="Plan">
          {plans.map((p) => (
            <label class="vt-check-label fl-plan">
              <input type="radio" name="plan" class="vt-radio" checked={p.current} />
              <span class="vt-check-label-content vt-flex-1">
                <span class="vt-check-label-title">{p.name}</span>
                <span class="vt-caption vt-text-foreground-muted">{p.desc}</span>
              </span>
              <span class="vt-label-md vt-whitespace-nowrap">{p.price}<span class="vt-caption vt-text-foreground-muted">/mo</span></span>
            </label>
          ))}
        </div>
      </div>
      <div class="vt-dialog-footer">
        <button type="button" class="vt-btn vt-btn-ghost" data-modal-close>Cancel</button>
        <button type="button" class="vt-btn vt-btn-primary" data-modal-close>Confirm plan</button>
      </div>
    </div>
  </div>

  <!-- Update card -->
  <div id="update-card-modal" class="vt-dialog-overlay" role="dialog" aria-modal="true" aria-labelledby="update-card-title">
    <div class="vt-dialog">
      <div class="vt-dialog-header">
        <div class="vt-dialog-heading">
          <h3 id="update-card-title" class="vt-dialog-title">Update payment method</h3>
          <p class="vt-dialog-description">Your card is encrypted and never stored by us.</p>
        </div>
      </div>
      <div class="vt-dialog-body">
        <div>
          <label class="vt-label vt-mb-1.5 vt-block" for="card-num">Card number</label>
          <input id="card-num" class="vt-input" type="text" inputmode="numeric" autocomplete="cc-number" placeholder="1234 1234 1234 1234" />
        </div>
        <div class="vt-grid vt-grid-cols-2 vt-gap-4">
          <div>
            <label class="vt-label vt-mb-1.5 vt-block" for="card-exp">Expiry</label>
            <input id="card-exp" class="vt-input" type="text" autocomplete="cc-exp" placeholder="MM / YY" />
          </div>
          <div>
            <label class="vt-label vt-mb-1.5 vt-block" for="card-cvc">CVC</label>
            <input id="card-cvc" class="vt-input" type="text" inputmode="numeric" autocomplete="cc-csc" placeholder="123" />
          </div>
        </div>
      </div>
      <div class="vt-dialog-footer">
        <button type="button" class="vt-btn vt-btn-ghost" data-modal-close>Cancel</button>
        <button type="button" class="vt-btn vt-btn-primary" data-modal-close>Save card</button>
      </div>
    </div>
  </div>

  <!-- Cancel subscription -->
  <div id="cancel-sub-modal" class="vt-dialog-overlay" role="dialog" aria-modal="true" aria-labelledby="cancel-sub-title">
    <div class="vt-dialog">
      <div class="vt-dialog-header">
        <div class="vt-icon-badge fl-tone-error"><TriangleAlert class="vt-w-5 vt-h-5" /></div>
        <div class="vt-dialog-heading">
          <h3 id="cancel-sub-title" class="vt-dialog-title">Cancel subscription?</h3>
          <p class="vt-dialog-description">You'll keep Pro features until Aug 1, 2026, then drop to the free Starter plan.</p>
        </div>
      </div>
      <div class="vt-dialog-footer">
        <button type="button" class="vt-btn vt-btn-ghost" data-modal-close>Keep Pro</button>
        <button type="button" class="vt-btn vt-btn-danger" data-modal-close>Cancel subscription</button>
      </div>
    </div>
  </div>
</FlorinShell>

<style>
  /* Plan picker rows are bordered tiles; the library's Check Label has no
     tile look, so the frame and the brand border on the picked plan live here. */
  .fl-plan {
    padding: var(--vt-spacing-4);
    border: var(--vt-border-width-thin) solid hsl(var(--vt-border-default));
    border-radius: var(--vt-radius-xl);
    transition: border-color var(--vt-transition-fast);
    accent-color: hsl(var(--vt-brand-fill)); /* native radio in the brand colour */
  }
  .fl-plan:hover,
  .fl-plan:has(:checked) { border-color: hsl(var(--vt-brand-fill)); }
</style>
